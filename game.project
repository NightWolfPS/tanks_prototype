[bootstrap]
main_collection = /main/bootstrap.collectionc

[script]
shared_state = 1

[display]
width = 960
height = 640
high_dpi = 1

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01

[html5]
scale_mode = stretch
show_made_with_defold = 0
show_fullscreen_button = 0
show_console_banner = 0

[project]
title = TankPrototype
dependencies#0 = https://github.com/defold/extension-websocket/archive/refs/tags/4.2.4.zip

