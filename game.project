[bootstrap]
main_collection = /main/bootstrap.collectionc

[script]
shared_state = 1

[display]
width = 1280
height = 720
high_dpi = 1
fullscreen = 0

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01

[html5]
scale_mode = stretch
show_made_with_defold = 0
show_fullscreen_button = 0
show_console_banner = 0

[project]
title = The tanks
developer = tEm04ka
version = 0.3.7
dependencies#0 = https://github.com/defold/extension-websocket/archive/refs/tags/4.2.4.zip
dependencies#1 = https://github.com/Insality/defold-event/archive/refs/tags/21.zip
dependencies#2 = https://github.com/Insality/druid/archive/refs/tags/1.4.0.zip

[render]
clear_color_alpha = 1.0

[library]
include_dirs = defold-input-master\defold-input-master\in

[collection_proxy]
max_count = 64

