-- auth.gui_script
-- First-launch profile creation.
-- Defold 1.13.1

local TEXT_SCALE = (32 / 72) * (2 / 3) -- Дополнительное уменьшение текста ещё на треть.
local PLAYER_SAVE_PATH = "player.save"
local MIN_NICKNAME_LENGTH = 3
local MAX_NICKNAME_LENGTH = 16

local COLORS = {
    background = vmath.vector4(0.035, 0.05, 0.06, 1),
    panel = vmath.vector4(0.08, 0.11, 0.12, 1),
    field = vmath.vector4(0.035, 0.05, 0.06, 1),
    button = vmath.vector4(0.28, 0.21, 0.11, 1),
    accent = vmath.vector4(0.95, 0.65, 0.20, 1),
    text = vmath.vector4(0.94, 0.95, 0.91, 1),
    muted = vmath.vector4(0.58, 0.66, 0.65, 1),
    error = vmath.vector4(1, 0.35, 0.30, 1)
}

local function create_box(position, size, color)
    local node = gui.new_box_node(position, size)
    gui.set_color(node, color)
    return node
end

local function create_text(position, value, scale, color)
    local node = gui.new_text_node(position, value)
    gui.set_scale(node, vmath.vector3(scale * TEXT_SCALE, scale * TEXT_SCALE, 1))
    gui.set_color(node, color)
    return node
end

local function utf8_length(value)
    local count = 0
    for i = 1, #value do
        local byte = string.byte(value, i)
        if byte < 128 or byte >= 192 then
            count = count + 1
        end
    end
    return count
end

local function normalize_nickname(value)
    if type(value) ~= "string" then return nil end
    value = value:gsub("[%c]", "")
    value = value:gsub("^%s+", ""):gsub("%s+$", "")

    local length = utf8_length(value)
    if length < MIN_NICKNAME_LENGTH or length > MAX_NICKNAME_LENGTH then
        return nil
    end

    return value
end

local function load_existing_profile()
    local ok, data = pcall(function()
        return sys.load(PLAYER_SAVE_PATH)
    end)

    if not ok or type(data) ~= "table" then return nil end
    return normalize_nickname(data.nickname)
end

local function destroy_nodes(self)
    for _, node in ipairs(self.nodes or {}) do
        if node then gui.delete_node(node) end
    end
    self.nodes = {}
end

local function add_node(self, node)
    self.nodes[#self.nodes + 1] = node
    return node
end

local function build_screen(self)
    destroy_nodes(self)

    self.width = gui.get_width()
    self.height = gui.get_height()
    self.scale = math.min(1, self.width / 900, self.height / 600)

    local center_x = self.width * 0.5
    local center_y = self.height * 0.5
    local panel_width = math.min(520 * self.scale, self.width * 0.88)
    local panel_height = 310 * self.scale

    add_node(self, create_box(
        vmath.vector3(center_x, center_y, -1),
        vmath.vector3(self.width, self.height, 0),
        COLORS.background
    ))

    add_node(self, create_box(
        vmath.vector3(center_x, center_y, 0),
        vmath.vector3(panel_width, panel_height, 0),
        COLORS.panel
    ))

    add_node(self, create_text(
        vmath.vector3(center_x, center_y + 95 * self.scale, 1),
        "CREATE YOUR PROFILE",
        1.15 * self.scale,
        COLORS.accent
    ))

    add_node(self, create_text(
        vmath.vector3(center_x, center_y + 52 * self.scale, 1),
        "Choose a nickname shown to other players",
        0.58 * self.scale,
        COLORS.muted
    ))

    self.field = add_node(self, create_box(
        vmath.vector3(center_x, center_y + 4 * self.scale, 1),
        vmath.vector3(panel_width - 72 * self.scale, 48 * self.scale, 0),
        COLORS.field
    ))

    self.input_node = add_node(self, create_text(
        vmath.vector3(center_x, center_y + 4 * self.scale, 1),
        "Type nickname...",
        0.72 * self.scale,
        COLORS.muted
    ))

    self.button = add_node(self, create_box(
        vmath.vector3(center_x, center_y - 68 * self.scale, 1),
        vmath.vector3(panel_width - 72 * self.scale, 48 * self.scale, 0),
        COLORS.button
    ))

    add_node(self, create_text(
        vmath.vector3(center_x, center_y - 68 * self.scale, 1),
        "CREATE PROFILE",
        0.72 * self.scale,
        COLORS.text
    ))

    self.hint_node = add_node(self, create_text(
        vmath.vector3(center_x, center_y - 116 * self.scale, 1),
        "3-16 characters. Press Enter to continue.",
        0.48 * self.scale,
        COLORS.muted
    ))

    self.screen_width = self.width
    self.screen_height = self.height
end

local function refresh_input(self)
    if self.nickname == "" then
        gui.set_text(self.input_node, "Type nickname...")
        gui.set_color(self.input_node, COLORS.muted)
    else
        gui.set_text(self.input_node, self.nickname)
        gui.set_color(self.input_node, COLORS.text)
    end
end

local function set_error(self, message)
    gui.set_text(self.hint_node, message)
    gui.set_color(self.hint_node, COLORS.error)
end

local function complete_auth(self)
    if self then self.finished = true end
    msg.post("bootstrap:/scene_manager#scene_manager", "auth_completed")
end

local function submit_profile(self)
    local nickname = normalize_nickname(self.nickname)
    if not nickname then
        set_error(self, "Nickname must contain 3-16 characters")
        return
    end

    local profile = { nickname = nickname }
    local load_ok, existing = pcall(function()
        return sys.load(PLAYER_SAVE_PATH)
    end)
    if load_ok and type(existing) == "table" then
        profile.client_identity_id = existing.client_identity_id
        profile.session_token = existing.session_token
    end

    local ok, result = pcall(function()
        return sys.save(PLAYER_SAVE_PATH, profile)
    end)

    if not ok or result == false then
        set_error(self, "Could not save profile. Try again.")
        print("[AUTH] Failed to save player.save: " .. tostring(result))
        return
    end

    print("[AUTH] Profile created: " .. nickname)
    complete_auth(self)
end

local function remove_last_character(value)
    if value == "" then return value end
    local index = #value
    while index > 1 do
        local byte = string.byte(value, index)
        if byte < 128 or byte >= 192 then break end
        index = index - 1
    end
    return string.sub(value, 1, index - 1)
end

function init(self)
    self.nodes = {}
    self.nickname = ""
    self.pressed_submit = false

    local existing_nickname = load_existing_profile()
    if existing_nickname then
        print("[AUTH] Existing profile found: " .. existing_nickname)
        complete_auth(self)
        return
    end

    build_screen(self)
    msg.post(".", "acquire_input_focus")
    print("[AUTH] No valid player.save profile found; waiting for nickname")
end

function final(self)
    destroy_nodes(self)
end

function update(self, dt)
    if self.finished then return end
    if gui.get_width() ~= self.screen_width
    or gui.get_height() ~= self.screen_height then
        build_screen(self)
        refresh_input(self)
    end
end

function on_input(self, action_id, action)
    if self.finished then return true end
    if action_id == hash("text_chat") then
        if action.text and action.text ~= "" then
            local typed = action.text:gsub("[%c]", "")
            local candidate = self.nickname .. typed
            if utf8_length(candidate) <= MAX_NICKNAME_LENGTH then
                self.nickname = candidate
                refresh_input(self)
                gui.set_text(self.hint_node, "3-16 characters. Press Enter to continue.")
                gui.set_color(self.hint_node, COLORS.muted)
            end
        end
        return true

    elseif action_id == hash("erase") then
        if action.pressed then
            self.nickname = remove_last_character(self.nickname)
            refresh_input(self)
        end
        return true

    elseif action_id == hash("chat") then
        if action.pressed then submit_profile(self) end
        return true

    elseif action_id == hash("touch") then
        if action.pressed then
            self.pressed_submit = self.button
                and gui.pick_node(self.button, action.x, action.y)
        elseif action.released then
            local should_submit = self.pressed_submit
                and self.button
                and gui.pick_node(self.button, action.x, action.y)
            self.pressed_submit = false
            if should_submit then submit_profile(self) end
        end
        return true
    end

    return true
end
