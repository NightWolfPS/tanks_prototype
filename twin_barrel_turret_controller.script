-- twin_barrel_turret_controller.script
-- Twin-barrel turret: alternates shots between right and left barrels.
-- Defold 1.13.1

go.property("turret_turn_speed", 120)
go.property("fire_cooldown", 0.5)
go.property("muzzle_distance", 50)
go.property("is_local_player", true)

local NETWORK_URL = msg.url("bootstrap:/network_manager#network_manager")
local RELOAD_HUD_URL = msg.url("main:/tank_hud#gui")

local REMOTE_INTERPOLATION_SPEED = 16
local LASER_RANGE = 800

-- Local coordinates of the barrel tips, relative to the turret.
local RIGHT_BARREL_OFFSET = vmath.vector3(8, 75, 0)
local LEFT_BARREL_OFFSET = vmath.vector3(-7, 75, 0)

local LASER_GROUPS = {
	hash("world"),
	hash("tank"),
	hash("bot")
}

local function clamp(value, min_value, max_value)
	return math.max(min_value, math.min(max_value, value))
end

local function get_first_hit(result)
	if type(result) == "table"
	and result.id == nil
	and result[1] ~= nil then
		return result[1]
	end

	return result
end

local function angle_difference(from_angle, to_angle)
	return (to_angle - from_angle + math.pi) % (2 * math.pi) - math.pi
end

local function get_barrel_position(self, rotation)
	local local_offset

	if self.next_barrel == "right" then
		local_offset = RIGHT_BARREL_OFFSET
	else
		local_offset = LEFT_BARREL_OFFSET
	end

	local turret_position = go.get_world_position()
	return turret_position + vmath.rotate(rotation, local_offset)
end

local function update_laser(self)
	if not self.laser_id then
		return
	end

	local rotation = go.get_world_rotation()
	local turret_position = go.get_world_position()
	local direction = vmath.rotate(
	rotation,
	vmath.vector3(0, 1, 0)
)

local start_position = turret_position
+ direction * self.muzzle_distance

local end_position = start_position + direction * LASER_RANGE

local hit = get_first_hit(
physics.raycast(start_position, end_position, LASER_GROUPS)
)

if type(hit) == "table" and hit.position then
end_position = hit.position
end

local delta = end_position - start_position
local length = math.max(1, vmath.length(delta))
local center = start_position + direction * (length * 0.5)
center.z = 0.3

pcall(go.set_position, center, self.laser_id)
pcall(go.set_rotation, rotation, self.laser_id)
pcall(
go.set_scale,
vmath.vector3(2, length, 1),
self.laser_id
)
end

local function send_reload_progress(self)
if not self.is_local_player then
return
end

local progress = 1

if self.fire_cooldown > 0 then
progress = 1 - self.fire_timer / self.fire_cooldown
end

progress = clamp(progress, 0, 1)

msg.post(RELOAD_HUD_URL, "reload_progress", {
progress = progress
})
end

local function get_owner_id(self)
-- Prefer the tank root explicitly assigned by the spawner.
if self.tank_owner_id then
return self.tank_owner_id
end

-- Fallback for existing turret hierarchies.
local parent_id = go.get_parent()

if not parent_id then
return go.get_id()
end

local grandparent_id = go.get_parent(parent_id)

if grandparent_id then
return grandparent_id
end

return parent_id
end

local function fire(self)
local rotation = go.get_world_rotation()
local spawn_position = get_barrel_position(self, rotation)

local direction = vmath.rotate(
rotation,
vmath.vector3(0, 1, 0)
)

self.shot_counter = self.shot_counter + 1

local barrel_name = self.next_barrel
local shot_id = tostring(go.get_id())
.. "_"
.. tostring(self.shot_counter)

-- Muzzle flash at the selected barrel's tip.
local ok_flash, flash_id = pcall(function()
return factory.create(
"#muzzle_flash_factory",
spawn_position,
rotation
)
end)

if ok_flash and flash_id then
msg.post(flash_id, "play_effect")
else
print(
"[TWIN TURRET] Muzzle flash factory error: "
.. tostring(flash_id)
)
end

-- Sound is played once per shot.
sound.play("#shoot")

local owner_id = get_owner_id(self)

local ok_projectile, projectile_id = pcall(function()
return factory.create(
"#projectile_factory",
spawn_position,
rotation,
{
damage = 30,
min_damage = 1,
owner_group = hash("tank"),
owner_id = owner_id,
is_visual_only = false
}
)
end)

if not ok_projectile or not projectile_id then
print(
"[TWIN TURRET] Projectile factory error: "
.. tostring(projectile_id)
)
return false
end

-- Assign the shot ID before reporting the shot to the server.
msg.post(projectile_id, "set_shot_id", {
shot_id = shot_id
})

local angle = math.atan2(direction.y, direction.x)

msg.post(NETWORK_URL, "network_send_shot", {
x = spawn_position.x,
y = spawn_position.y,
z = spawn_position.z,
angle = angle,
shot_id = shot_id
})

print(
"[TWIN TURRET] Fired from "
.. barrel_name
.. " barrel: "
.. shot_id
)

-- Alternate only after successfully creating a projectile.
if self.next_barrel == "right" then
self.next_barrel = "left"
else
self.next_barrel = "right"
end

return true
end

local function clear_turret_input(self)
self.turret_left = false
self.turret_right = false
self.fire_pressed = false
sound.stop("#turret1")
end

function init(self)
self.turret_left = false
self.turret_right = false
self.fire_pressed = false

self.battle_menu_open = false
self.chat_open = false

self.fire_timer = 0
self.shot_counter = 0

self.remote_target_angle = nil
self.stun_timer = 0

self.gun_damage_reloads = 0
self.gun_reload_penalty = 1.5

self.tank_owner_id = nil

-- Start with the right barrel.
self.next_barrel = "right"

local _, _, angle = vmath.quat_to_euler(go.get_rotation())
self.turret_angle = angle

if self.is_local_player then
msg.post(".", "acquire_input_focus")

local ok_laser, laser_id = pcall(function()
return factory.create(
"#laser_factory",
go.get_world_position(),
go.get_world_rotation()
)
end)

if ok_laser and laser_id then
self.laser_id = laser_id

local laser_sprite_url = msg.url(
"main",
laser_id,
hash("sprite")
)

pcall(
sprite.set_constant,
laser_sprite_url,
"tint",
vmath.vector4(1, 0.08, 0.08, 0.32)
)
else
self.laser_id = nil

print(
"[TWIN TURRET] Laser sight unavailable: "
.. tostring(laser_id)
)
end

send_reload_progress(self)
else
self.laser_id = nil

print(
"[NETWORK] Remote twin-barrel turret initialized: "
.. tostring(go.get_id())
)
end
end

function on_input(self, action_id, action)
if not self.is_local_player then
return false
end

if self.battle_menu_open or self.chat_open then
if action_id == hash("z")
or action_id == hash("x")
or action_id == hash("space") then
return true
end

return false
end

if action_id == hash("z") then
if action.pressed then
self.turret_left = true
sound.play("#turret1")
elseif action.released then
self.turret_left = false
sound.stop("#turret1")
end

return true

elseif action_id == hash("x") then
if action.pressed then
self.turret_right = true
sound.play("#turret1")
elseif action.released then
self.turret_right = false
sound.stop("#turret1")
end

return true

elseif action_id == hash("space") then
if action.pressed then
self.fire_pressed = true
elseif action.released then
self.fire_pressed = false
end

return true
end

return false
end

function update(self, dt)
if not self.is_local_player then
if self.remote_target_angle ~= nil then
local alpha = clamp(
dt * REMOTE_INTERPOLATION_SPEED,
0,
1
)

self.turret_angle = self.turret_angle
+ angle_difference(
self.turret_angle,
self.remote_target_angle
) * alpha

go.set_rotation(
vmath.quat_rotation_z(self.turret_angle)
)
end

return
end

self.stun_timer = math.max(0, self.stun_timer - dt)

if self.battle_menu_open or self.chat_open then
clear_turret_input(self)

if self.fire_timer > 0 then
self.fire_timer = math.max(0, self.fire_timer - dt)
end

update_laser(self)
send_reload_progress(self)
return
end

if self.stun_timer <= 0 then
if self.turret_left then
self.turret_angle = self.turret_angle
+ math.rad(self.turret_turn_speed) * dt
end

if self.turret_right then
self.turret_angle = self.turret_angle
- math.rad(self.turret_turn_speed) * dt
end
end

go.set_rotation(vmath.quat_rotation_z(self.turret_angle))

update_laser(self)

if self.fire_timer > 0 then
self.fire_timer = math.max(0, self.fire_timer - dt)
end

if self.fire_pressed
and self.fire_timer <= 0
and self.stun_timer <= 0 then
fire(self)

local reload_multiplier = 1

if self.gun_damage_reloads > 0 then
reload_multiplier = self.gun_reload_penalty
self.gun_damage_reloads = self.gun_damage_reloads - 1
end

self.fire_timer = self.fire_cooldown * reload_multiplier
end

send_reload_progress(self)
end

function on_message(self, message_id, message, sender)
if message_id == hash("set_tank_owner") then
self.tank_owner_id = message.tank_id
or message.owner_id
or message.tank_owner_id

print(
"[TWIN TURRET] Tank owner assigned: "
.. tostring(self.tank_owner_id)
)
return
end

if message_id == hash("set_turret_reference") then
self.turret_id = message.turret_id
return
end

if message_id == hash("initialize_turret_local") then
self.turret_angle = 0
self.remote_target_angle = nil
go.set_rotation(vmath.quat())

-- Reset the firing sequence for a newly initialized turret.
self.next_barrel = "right"
return
end

if message_id == hash("battle_menu_state") then
if self.is_local_player then
self.battle_menu_open = message.open == true

if self.battle_menu_open then
clear_turret_input(self)
end
end

return
end

if message_id == hash("chat_state") then
if self.is_local_player then
self.chat_open = message.open == true

if self.chat_open then
clear_turret_input(self)
end
end

return
end

if message_id == hash("network_remote_turret_state")
and not self.is_local_player then
self.remote_target_angle = tonumber(message.angle)
or self.turret_angle

return
end

if message_id == hash("status_effects")
and self.is_local_player then
local effects = type(message.effects) == "table"
and message.effects
or {}

if tonumber(effects.stun_duration)
and effects.stun_duration > 0 then
self.stun_timer = math.max(
self.stun_timer,
effects.stun_duration
)
end

if tonumber(effects.gun_damage_reloads)
and effects.gun_damage_reloads > 0 then
self.gun_damage_reloads = math.max(
self.gun_damage_reloads,
math.floor(effects.gun_damage_reloads)
)

self.fire_timer = self.fire_cooldown
* self.gun_reload_penalty
end

if effects.expired == "stun" then
self.stun_timer = 0
end
end
end

function final(self)
sound.stop("#turret1")

if self.laser_id then
pcall(go.delete, self.laser_id)
self.laser_id = nil
end
end