
-- network_manager.script
-- Multiplayer: match lifecycle, remote tank routing, validated hits,
-- scoreboard, ping and server-authorized respawn.
-- Defold 1.13.1 + extension-websocket

local SERVER_URL = "wss://tank-server-dfii.onrender.com"
local STATE_SEND_INTERVAL = 0.05

-- Forward declarations.
local remove_remote_player
local clear_remote_players
local remember_player
local create_remote_tank
local create_remote_shot
local handle_server_message

-- ---------------------------------------------------------------------------
-- Logging and validation
-- ---------------------------------------------------------------------------

local function log(message)
    print("[NETWORK] " .. tostring(message))
end

local function is_number(value)
    return type(value) == "number"
    and value == value
    and value ~= math.huge
    and value ~= -math.huge
end

-- ---------------------------------------------------------------------------
-- Scene routing
-- ---------------------------------------------------------------------------

local function scene_url(self, path)
    if not self.scene_socket or self.scene_socket == "" then
        return nil
    end

    return msg.url(self.scene_socket .. ":" .. path)
end

local function post_to_scene(self, path, message_id, payload)
    local url = scene_url(self, path)

    if not url then
        return false
    end

    if payload ~= nil then
        msg.post(url, message_id, payload)
    else
        msg.post(url, message_id)
    end

    return true
end

local function post_to_spawner(self, message_id, payload)
    return post_to_scene(
    self,
    "/tank_spawner#tank_spawner",
    message_id,
    payload
)
end

-- ---------------------------------------------------------------------------
-- WebSocket messaging
-- ---------------------------------------------------------------------------

local function send_json(self, payload)
if not self.connected or self.connection == nil then
    return false
end

local ok, encoded = pcall(json.encode, payload)

if not ok then
    log("JSON encode failed: " .. tostring(encoded))
    return false
end

local send_ok, send_error = pcall(function()
    websocket.send(self.connection, encoded, {
        type = websocket.DATA_TYPE_TEXT
    })
end)

if not send_ok then
    log("WebSocket send failed: " .. tostring(send_error))
    return false
end

return true
end

local function send_enter_battle(self)
if not self.connected then
    log("Cannot enter battle: WebSocket is not connected")
    return false
end

if self.in_battle or self.enter_battle_pending then
    return true
end

self.enter_battle_pending = true

if not send_json(self, {
    type = "enter_battle"
}) then
    self.enter_battle_pending = false
    return false
end

log("Requested battle entry")
return true
end

local function send_leave_battle(self)
if not self.connected then
    self.in_battle = false
    self.enter_battle_pending = false
    return false
end

if not self.in_battle and not self.enter_battle_pending then
    return false
end

self.in_battle = false
self.enter_battle_pending = false
self.local_state = nil
self.state_timer = 0

send_json(self, {
    type = "leave_battle"
})

log("Requested leaving battle")
return true
end

local function post_player_ready(self)
if not self.in_battle or not self.scene_socket then
    return
end

if not self.player_id or not is_number(self.spawn_index) then
    log("Cannot initialize local player: missing player ID or spawn index")
    return
end

post_to_spawner(self, "network_player_ready", {
    player_id = self.player_id,
    spawn_index = self.spawn_index
})
end

-- ---------------------------------------------------------------------------
-- Remote players
--
-- IMPORTANT:
-- network_manager never creates, deletes, or posts to remote tank instances.
-- All remote tank instances belong to the gameplay collection and are managed
-- by tank_spawner.script.
-- ---------------------------------------------------------------------------

create_remote_tank = function(self, player)
if not self.in_battle or not self.scene_socket then
    return
end

if type(player) ~= "table"
or type(player.id) ~= "string"
or player.id == ""
or player.id == self.player_id then
    return
end

if player.life_state == "dead"
or player.life_state == "inactive" then
    remove_remote_player(self, player.id)
    return
end

if not is_number(player.x) or not is_number(player.y) then
    return
end

-- Sending state also instructs tank_spawner to create the tank if needed.
post_to_spawner(self, "network_remote_player_state", {
    player_id = player.id,
    x = player.x,
    y = player.y,
    body_angle = player.body_angle or 0,
    turret_angle = player.turret_angle or 0,
    state_seq = player.state_seq or 0
})
end

remember_player = function(self, player)
if not self.in_battle then
    return
end

if type(player) ~= "table"
or type(player.id) ~= "string"
or player.id == ""
or player.id == self.player_id then
    return
end

if player.life_state == "dead"
or player.life_state == "inactive" then
    remove_remote_player(self, player.id)
    return
end

local old = self.remote_players[player.id] or {
    id = player.id,
    x = nil,
    y = nil,
    body_angle = 0,
    turret_angle = 0,
    state_seq = 0,
    life_state = "alive"
}

if is_number(player.spawn_index) then
    old.spawn_index = player.spawn_index
end

if is_number(player.x) and is_number(player.y) then
    if is_number(player.state_seq)
    and is_number(old.state_seq)
    and player.state_seq < old.state_seq then
        return
    end

    old.x = player.x
    old.y = player.y

    if is_number(player.body_angle) then
        old.body_angle = player.body_angle
    end

    if is_number(player.turret_angle) then
        old.turret_angle = player.turret_angle
    end

    if is_number(player.state_seq) then
        old.state_seq = player.state_seq
    end
end

old.life_state = player.life_state or old.life_state or "alive"

self.remote_players[player.id] = old

if is_number(old.x) and is_number(old.y) then
    create_remote_tank(self, old)
end
end

remove_remote_player = function(self, player_id)
if type(player_id) ~= "string" then
    return
end

-- Removal is routed to the collection that owns the tank instances.
post_to_spawner(self, "network_remote_player_remove", {
    player_id = player_id
})

self.remote_instances[player_id] = nil
self.remote_players[player_id] = nil

log("Requested removal of remote tank for " .. player_id)
end

clear_remote_players = function(self)
local ids = {}
local seen = {}

-- Include players whose tanks have been requested but whose instance
-- registration message has not yet arrived.
for player_id in pairs(self.remote_players or {}) do
    if not seen[player_id] then
        seen[player_id] = true
        ids[#ids + 1] = player_id
    end
end

for player_id in pairs(self.remote_instances or {}) do
    if not seen[player_id] then
        seen[player_id] = true
        ids[#ids + 1] = player_id
    end
end

for _, player_id in ipairs(ids) do
    remove_remote_player(self, player_id)
end

self.remote_players = {}
self.remote_instances = {}
end

-- ---------------------------------------------------------------------------
-- Remote instance registration
--
-- tank_spawner sends IDs after successfully creating a remote tank.
-- We store IDs only to match physics raycast results with server player IDs.
-- No instance API is called from this script.
-- ---------------------------------------------------------------------------

local function register_remote_instance(self, message)
local player_id = message.player_id

if type(player_id) ~= "string" or player_id == "" then
    return
end

-- If the player has already left, discard a late registration.
if not self.in_battle or not self.remote_players[player_id] then
    post_to_spawner(self, "network_remote_player_remove", {
        player_id = player_id
    })
    return
end

local registered_ids = {}

if type(message.ids) == "table" then
    for _, object_id in pairs(message.ids) do
        if object_id ~= nil then
            registered_ids[#registered_ids + 1] = object_id
        end
    end
end

if message.root_id ~= nil then
    registered_ids[#registered_ids + 1] = message.root_id
end

self.remote_instances[player_id] = {
    root_id = message.root_id,
    ids = registered_ids
}

log("Registered remote tank IDs for " .. player_id
.. " (" .. #registered_ids .. " objects)")
end

local function unregister_remote_instance(self, message)
local player_id = message.player_id

if type(player_id) ~= "string" then
    return
end

self.remote_instances[player_id] = nil

log("Unregistered remote tank IDs for " .. player_id)
end

local function find_remote_player_for_object(self, object_id)
if object_id == nil then
    return nil
end

for player_id, instance in pairs(self.remote_instances) do
    if instance.root_id == object_id then
        return player_id
    end

    for _, registered_id in ipairs(instance.ids or {}) do
        if registered_id == object_id then
            return player_id
        end
    end
end

return nil
end

-- ---------------------------------------------------------------------------
-- Remote projectile visuals
-- ---------------------------------------------------------------------------

create_remote_shot = function(self, player_id, shot)
if not self.in_battle or not self.scene_socket then
    return
end

if type(player_id) ~= "string"
or player_id == self.player_id
or type(shot) ~= "table" then
    return
end

-- tank_spawner owns the remote tank and its turret factories.
-- It also queues shots while the remote tank is being created.
post_to_spawner(self, "network_remote_shot", {
    player_id = player_id,
    x = is_number(shot.x) and shot.x or 0,
    y = is_number(shot.y) and shot.y or 0,
    z = is_number(shot.z) and shot.z or 0.5,
    angle = is_number(shot.angle) and shot.angle or 0,
    shot_id = type(shot.shot_id) == "string" and shot.shot_id or ""
})
end

-- ---------------------------------------------------------------------------
-- Server messages
-- ---------------------------------------------------------------------------

handle_server_message = function(self, message)
if type(message) ~= "table"
or type(message.type) ~= "string" then
    log("Ignored malformed server message")
    return
end

if message.type == "ping" then
    if is_number(message.ping_id) then
        send_json(self, {
            type = "pong",
            ping_id = message.ping_id
        })
    else
        log("Ignored ping without a valid ping_id")
    end

    return

elseif message.type == "welcome" then
    self.player_id = message.player_id
    self.spawn_index = nil
    self.in_battle = false
    self.enter_battle_pending = false

    log("Connected as " .. tostring(self.player_id))

    if self.scene_name == "battle" and self.scene_socket then
        send_enter_battle(self)
    end

elseif message.type == "enter_battle_accepted" then
    self.enter_battle_pending = false
    self.in_battle = true

    if type(message.player_id) == "string" then
        self.player_id = message.player_id
    end

    self.spawn_index = tonumber(message.spawn_index)

    log(
    "Entered battle as " .. tostring(self.player_id)
    .. ", spawn index " .. tostring(self.spawn_index)
)

-- Clear any old match instances before registering this match.
clear_remote_players(self)

-- Initialize the local tank only after server acceptance.
post_player_ready(self)

-- The server provides the current participants.
for _, player in ipairs(message.players or {}) do
    remember_player(self, player)
end

elseif message.type == "enter_battle_rejected" then
self.enter_battle_pending = false
self.in_battle = false
self.local_state = nil
self.state_timer = 0

clear_remote_players(self)

log("Battle entry rejected: " .. tostring(message.reason))

post_to_spawner(
self,
"network_battle_entry_rejected",
{
    reason = message.reason or "unknown"
}
)

elseif message.type == "leave_battle_accepted" then
log("Server confirmed leaving battle")

elseif message.type == "ready" then
log("Server acknowledged readiness")

elseif message.type == "player_joined" then
remember_player(self, message.player)

elseif message.type == "player_left" then
remove_remote_player(self, message.player_id)

elseif message.type == "player_inactive" then
remove_remote_player(self, message.player_id)

elseif message.type == "state" then
remember_player(self, {
id = message.player_id,
x = message.x,
y = message.y,
body_angle = message.body_angle,
turret_angle = message.turret_angle,
state_seq = message.state_seq,
life_state = "alive"
})

elseif message.type == "shot" then
if type(message.player_id) == "string"
and message.player_id ~= self.player_id then
create_remote_shot(self, message.player_id, message)
end

elseif message.type == "shot_registered" then
log(
"Shot accepted: client=" .. tostring(message.client_shot_id)
.. ", server=" .. tostring(message.shot_id)
)

elseif message.type == "shot_rejected" then
log("Shot rejected: " .. tostring(message.reason))

elseif message.type == "hit_rejected" then
log("Hit rejected: " .. tostring(message.reason))

elseif message.type == "projectile_hit" then
log(
"Hit: " .. tostring(message.player_id)
.. " -> " .. tostring(message.target_player_id)
.. ", damage=" .. tostring(message.damage)
.. ", HP=" .. tostring(message.hp)
)

if message.target_player_id == self.player_id then
post_to_spawner(self, "network_apply_damage", {
damage = tonumber(message.damage) or 0,
killer_id = message.player_id,
hit_x = message.x,
hit_y = message.y,
effects = message.effects or {},
critical = message.effects
and message.effects.critical == true
})
end

elseif message.type == "status_damage" then
if message.target_player_id == self.player_id then
post_to_spawner(self, "network_apply_damage", {
damage = tonumber(message.damage) or 0,
killer_id = message.killer_id or "",
effect = message.effect or "burn",
status_tick = true
})
end

elseif message.type == "status_effect_expired" then
if message.target_player_id == self.player_id then
post_to_spawner(self, "network_status_expired", {
effect = message.effect or ""
})
end

elseif message.type == "player_killed" then
log(
"Server kill confirmation: "
.. tostring(message.killer_id)
.. " -> "
.. tostring(message.victim_id)
)

elseif message.type == "respawn_accepted" then
log("Server accepted respawn")

post_to_spawner(self, "network_respawn_accepted", {
player_id = message.player_id,
spawn_index = tonumber(message.spawn_index)
})

elseif message.type == "respawn_rejected" then
log("Respawn rejected: " .. tostring(message.reason))

post_to_spawner(self, "network_respawn_rejected", {
reason = message.reason
})

elseif message.type == "scoreboard" then
local players = message.players

if type(players) ~= "table" then
log("Ignored malformed scoreboard")
return
end

-- Do not render match statistics in the menu.
if not self.in_battle or not self.scene_socket then
return
end

local count = math.min(#players, 6)

post_to_scene(self, "/tank_hud#gui", "server_scoreboard_reset", {
count = count
})

for index, player in ipairs(players) do
if index > 6 then
break
end

if type(player) == "table"
and type(player.id) == "string" then
post_to_scene(self, "/tank_hud#gui", "server_scoreboard_row", {
row = index - 1,
player_id = player.id,
name = player.id,
points = tonumber(player.score) or 0,
damage = tonumber(player.damage_dealt) or 0,
ping = tonumber(player.ping) or 0,
kills = tonumber(player.kills) or 0,
deaths = tonumber(player.deaths) or 0,
is_local = player.id == self.player_id
})
end
end

elseif message.type == "kill_feed" then
if self.in_battle
and self.scene_socket
and type(message.victim_id) == "string" then
post_to_scene(self, "/tank_hud#gui", "killfeed_event", {
killer_id = message.killer_id or "WORLD",
victim_id = message.victim_id
})
end

elseif message.type == "error" then
log("Server error: " .. tostring(message.message))

elseif message.type == "state_rejected" then
log("State rejected: " .. tostring(message.reason))

else
log("Unknown server event: " .. tostring(message.type))
end
end

-- ---------------------------------------------------------------------------
-- WebSocket callback
-- ---------------------------------------------------------------------------

local function websocket_callback(self, connection, data)
if data.event == websocket.EVENT_CONNECTED then
self.connection = connection
self.connected = true

log("Connected to " .. SERVER_URL)

if self.scene_name == "battle" and self.scene_socket then
send_enter_battle(self)
end

elseif data.event == websocket.EVENT_DISCONNECTED then
if self.connection == connection then
self.connection = nil
end

self.connected = false
self.player_id = nil
self.spawn_index = nil
self.local_state = nil
self.in_battle = false
self.enter_battle_pending = false
self.state_timer = 0

clear_remote_players(self)

post_to_spawner(self, "network_disconnected")

log(
"Disconnected: "
.. tostring(data.code or data.message or "no reason")
)

elseif data.event == websocket.EVENT_ERROR then
log("WebSocket error: " .. tostring(data.message))

if data.handshake_response then
log(
"Handshake status: "
.. tostring(data.handshake_response.status)
)
end

elseif data.event == websocket.EVENT_MESSAGE then
local ok, decoded = pcall(json.decode, data.message)

if not ok then
log("JSON decode failed: " .. tostring(decoded))
return
end

handle_server_message(self, decoded)
end
end

-- ---------------------------------------------------------------------------
-- Defold lifecycle
-- ---------------------------------------------------------------------------

function init(self)
self.scene_socket = nil
self.scene_name = "none"

self.connection = nil
self.connected = false

self.player_id = nil
self.spawn_index = nil

self.in_battle = false
self.enter_battle_pending = false

self.remote_players = {}
self.remote_instances = {}

self.local_state = nil
self.state_timer = 0

log("Connecting to " .. SERVER_URL)

self.connection = websocket.connect(SERVER_URL, {
timeout = 3000
}, websocket_callback)
end

function update(self, dt)
if not self.connected
or not self.in_battle
or self.scene_name ~= "battle"
or self.local_state == nil then
return
end

self.state_timer = self.state_timer + dt

if self.state_timer < STATE_SEND_INTERVAL then
return
end

self.state_timer = self.state_timer - STATE_SEND_INTERVAL

send_json(self, {
type = "state",
x = self.local_state.x,
y = self.local_state.y,
body_angle = self.local_state.body_angle,
turret_angle = self.local_state.turret_angle
})
end

function on_message(self, message_id, message, sender)
-- Registration messages come from tank_spawner in the gameplay
-- collection. These messages contain IDs only; no instance access here.
if message_id == hash("network_remote_instance_registered") then
register_remote_instance(self, message)
return

elseif message_id == hash("network_remote_instance_unregistered") then
unregister_remote_instance(self, message)
return
end

if message_id == hash("network_scene_changed") then
local new_scene_name = message.scene or "none"
local new_socket = nil

if new_scene_name == "battle"
and type(message.socket) == "string"
and message.socket ~= "" then
new_socket = message.socket
end

local was_battle_scene =
self.scene_name == "battle"
and self.scene_socket ~= nil

local is_battle_scene =
new_scene_name == "battle"
and new_socket ~= nil

local socket_changed = self.scene_socket ~= new_socket
local scene_changed = self.scene_name ~= new_scene_name

if was_battle_scene
and (not is_battle_scene or socket_changed) then
send_leave_battle(self)
clear_remote_players(self)
end

self.scene_name = new_scene_name
self.scene_socket = new_socket

if socket_changed or scene_changed then
self.local_state = nil
self.state_timer = 0
end

if is_battle_scene then
if socket_changed then
clear_remote_players(self)
end

if self.connected then
send_enter_battle(self)
end
else
self.local_state = nil
self.state_timer = 0
end

log(
"Active scene route: " .. tostring(self.scene_name)
.. ", socket: " .. tostring(self.scene_socket)
)

return
end

if message_id == hash("network_set_state") then
if not self.in_battle or self.scene_name ~= "battle" then
return
end

self.local_state = {
x = message.x or 0,
y = message.y or 0,
body_angle = message.body_angle or 0,
turret_angle = message.turret_angle or 0
}

elseif message_id == hash("network_player_inactive") then
if self.connected and self.in_battle then
send_json(self, {
type = "player_inactive"
})
end

self.local_state = nil
self.state_timer = 0

elseif message_id == hash("network_request_respawn") then
if self.connected and self.in_battle then
send_json(self, {
type = "player_respawn"
})
end

elseif message_id == hash("network_send_shot") then
if not self.connected or not self.in_battle then
return
end

send_json(self, {
type = "shot",
x = message.x or 0,
y = message.y or 0,
z = message.z or 0.5,
angle = message.angle or 0,
shot_id = message.shot_id or ""
})

elseif message_id == hash("network_player_killed") then
-- The server decides kill credit using registered projectile hits.
if self.connected and self.in_battle then
send_json(self, {
type = "player_killed",
killer_id = type(message.killer_id) == "string"
and message.killer_id or ""
})
end

elseif message_id == hash("network_send_hit") then
if not self.connected or not self.in_battle then
return
end

local target_player_id = find_remote_player_for_object(
self,
message.target_gameobject_id
)

if not target_player_id then
log("Hit not sent: target object ID is not registered")
return
end

send_json(self, {
type = "projectile_hit",
target_player_id = target_player_id,
damage = message.damage or 0,
x = message.x or 0,
y = message.y or 0,
shot_id = message.shot_id or ""
})

elseif message_id == hash("network_disconnect") then
if self.in_battle or self.enter_battle_pending then
send_leave_battle(self)
end

clear_remote_players(self)

if self.connection ~= nil then
websocket.disconnect(self.connection)
self.connection = nil
end

self.connected = false
self.in_battle = false
self.enter_battle_pending = false
self.local_state = nil
self.state_timer = 0
end
end

function final(self)
clear_remote_players(self)

if self.connection ~= nil then
websocket.disconnect(self.connection)
self.connection = nil
end
end
