-- tank_spawner.script
-- Local and remote tank spawning, server-authorized respawn,
-- remote projectiles and damage forwarding.
-- Defold 1.13.1

go.property("spawn_delay", 0.5)

local TANK_COLLECTION_FACTORY_URL = msg.url("main:/tank_spawner#tank_collection_factory")
local GARAGE_SAVE_PATH = "garage.save"
local DEFAULT_HULL_ID = "light_hull"
local DEFAULT_TURRET_ID = "tank_turret"

-- Resource directories.
-- Every new hull and turret is discovered by its ID.
local HULL_DIRECTORY = "/main/objects/hulls/"
local TURRET_DIRECTORY = "/main/objects/turrets/"

local function is_valid_resource_id(value)
    return type(value) == "string"
    and value ~= ""
    and string.match(value, "^[%w_%-]+$") ~= nil
end

local function normalize_hull_id(value)
    if is_valid_resource_id(value) then
        return value
    end

    return DEFAULT_HULL_ID
end

local function normalize_turret_id(value)
    if is_valid_resource_id(value) then
        return value
    end

    return DEFAULT_TURRET_ID
end

local function get_hull_prototype(hull_id)
    return HULL_DIRECTORY .. hull_id .. ".collectionc"
end

local function get_turret_prototype(turret_id)
    return TURRET_DIRECTORY .. turret_id .. ".goc"
end

local function load_garage_loadout()
    local ok, data = pcall(function()
        return sys.load(GARAGE_SAVE_PATH)
    end)

    if not ok or type(data) ~= "table" then
        return DEFAULT_HULL_ID, DEFAULT_TURRET_ID
    end

    return normalize_hull_id(data.hull_id),
    normalize_turret_id(data.turret_id)
end

local function load_garage_loadout()
    local ok, data = pcall(function()
        return sys.load(GARAGE_SAVE_PATH)
    end)
    if not ok or type(data) ~= "table" then
        return DEFAULT_HULL_ID, DEFAULT_TURRET_ID
    end
    return normalize_hull_id(data.hull_id), normalize_turret_id(data.turret_id)
end

local function tank_component_url(root_id, component_id)
    return msg.url("main", root_id, hash(component_id))
end

local CAMERA_URL = msg.url("main:/camera")
local NETWORK_MANAGER_URL = msg.url("bootstrap:/network_manager#network_manager")

-- IDs used by tank.collection and light_hull.collection.
local TANK_CONTAINER_ID = hash("/tank")

-- Compatibility aliases used by existing networking scripts.
local TANK_ROOT_ID = hash("/light_hull")
local TANK_PIVOT_ID = hash("/pivot")
local TANK_TURRET_ID = hash("/tank_turret")
local TANK_CONTAINER_ALIAS = hash("/tank_container")

local REGISTRATION_WAIT = 0.25
local MAX_PENDING_SHOTS = 8
local GROUP_TANK = hash("tank")

-- Create the tank shell first, then configure its two dynamic factories.
-- The returned root is the selected hull (the object with tank_controller).
local function create_configured_tank(
    self,
    position,
    rotation,
    hull_id,
    turret_id,
    is_local,
    on_complete
)
hull_id = normalize_hull_id(hull_id)
turret_id = normalize_turret_id(turret_id)

local hull_prototype = get_hull_prototype(hull_id)
local turret_prototype = get_turret_prototype(turret_id)

print("[SPAWNER] Hull: " .. hull_id)
print("[SPAWNER] Hull resource: " .. hull_prototype)

print("[SPAWNER] Turret: " .. turret_id)
print("[SPAWNER] Turret resource: " .. turret_prototype)

-- Create the permanent tank container.
local ok_shell, shell_ids = pcall(function()
    return collectionfactory.create(
    TANK_COLLECTION_FACTORY_URL,
    position,
    rotation
)
end)

if not ok_shell or not shell_ids then
on_complete(
false,
"tank.collection creation failed: " .. tostring(shell_ids)
)
return
end

local container_id = shell_ids[TANK_CONTAINER_ID]

if not container_id then
pcall(go.delete, shell_ids, true)

on_complete(
false,
"tank.collection did not return /tank"
)
return
end

local hull_factory_url = tank_component_url(
container_id,
"hull_collection_factory"
)

local turret_factory_url = tank_component_url(
container_id,
"turret_factory"
)

local function fail(reason, hull_ids, turret_instance)
if turret_instance then
pcall(go.delete, turret_instance, true)
end

if hull_ids then
pcall(go.delete, hull_ids, true)
end

pcall(go.delete, container_id, true)

on_complete(false, reason)
end

-- Configure the dynamic hull factory.
local ok_hull_prototype, hull_error = pcall(function()
collectionfactory.unload(hull_factory_url)

collectionfactory.set_prototype(
hull_factory_url,
hull_prototype
)
end)

if not ok_hull_prototype then
fail(
"failed to configure hull prototype "
.. hull_id .. ": " .. tostring(hull_error)
)
return
end

-- Configure the dynamic turret factory.
local ok_turret_prototype, turret_error = pcall(function()
factory.unload(turret_factory_url)

factory.set_prototype(
turret_factory_url,
turret_prototype
)
end)

if not ok_turret_prototype then
fail(
"failed to configure turret prototype "
.. turret_id .. ": " .. tostring(turret_error)
)
return
end

-- Load the selected hull.
collectionfactory.load(
hull_factory_url,
function(_, _, hull_loaded)

if not hull_loaded then
fail("failed to load hull collection: " .. hull_id)
return
end

-- Load the selected turret.
factory.load(
turret_factory_url,
function(_, _, turret_loaded)

if not turret_loaded then
fail("failed to load turret: " .. turret_id)
return
end

-- Create hull.
local hull_properties = {
[hash("/" .. hull_id)] = {
is_local_player = is_local
}
}

local ok_hull, hull_ids = pcall(function()
return collectionfactory.create(
hull_factory_url,
position,
rotation,
hull_properties
)
end)

if not ok_hull or not hull_ids then
fail(
"failed to create hull "
.. hull_id .. ": " .. tostring(hull_ids)
)
return
end

-- Resolve hull root by its collection instance ID.
local hull_root = hull_ids[
hash("/" .. hull_id)
]

-- Resolve the mounting point.
-- Every hull uses the same semantic name: pivot.
local pivot_id = hull_ids[TANK_PIVOT_ID]

if not hull_root then
fail(
"hull root not found: /" .. hull_id,
hull_ids
)
return
end

if not pivot_id then
fail(
"hull pivot not found: /pivot",
hull_ids
)
return
end

-- Attach the permanent tank container to the hull.
local ok_parent, parent_error = pcall(
go.set_parent,
container_id,
hull_root,
true
)

if not ok_parent then
fail(
"failed to parent tank container: "
.. tostring(parent_error),
hull_ids
)
return
end

-- Read the actual world transform of the pivot.
-- No manually configured hull offsets.
local ok_position, pivot_position = pcall(
go.get_world_position,
pivot_id
)

local ok_rotation, pivot_rotation = pcall(
go.get_world_rotation,
pivot_id
)

if not ok_position or not pivot_position then
fail(
"failed to read pivot world position",
hull_ids
)
return
end

if not ok_rotation or not pivot_rotation then
fail(
"failed to read pivot world rotation",
hull_ids
)
return
end

-- Create the turret exactly at the pivot transform.
local turret_properties = {
is_local_player = is_local
}

local ok_turret, turret_instance = pcall(function()
return factory.create(
turret_factory_url,
pivot_position,
pivot_rotation,
turret_properties
)
end)

if not ok_turret or not turret_instance then
fail(
"failed to create turret "
.. turret_id .. ": "
.. tostring(turret_instance),
hull_ids
)
return
end

-- Parent turret to the actual pivot.
local ok_turret_parent, turret_parent_error = pcall(
go.set_parent,
turret_instance,
pivot_id,
true
)

if not ok_turret_parent then
fail(
"failed to parent turret to pivot: "
.. tostring(turret_parent_error),
hull_ids,
turret_instance
)
return
end

-- The controller component ID follows the turret ID.
local turret_controller_id = hash(
turret_id .. "_controller"
)

msg.post(
hull_root,
"set_turret_reference",
{
turret_id = turret_instance,
controller_id = turret_controller_id
}
)

msg.post(
turret_instance,
"initialize_turret_local"
)

-- Preserve every created object.
local all_ids = {}

for key, value in pairs(shell_ids) do
all_ids[key] = value
end

for key, value in pairs(hull_ids) do
all_ids[key] = value
end

-- Compatibility aliases for existing scripts.
all_ids[TANK_ROOT_ID] = hull_root
all_ids[TANK_PIVOT_ID] = pivot_id
all_ids[TANK_TURRET_ID] = turret_instance
all_ids[TANK_CONTAINER_ALIAS] = container_id

on_complete(true, {
ids = all_ids,

root_id = hull_root,
container_id = container_id,
pivot_id = pivot_id,
turret_id = turret_instance,

hull_id = hull_id,
turret_loadout_id = turret_id
})
end
)
end
)
end

-- ============================================================
-- Spawn points
-- ============================================================

local function reserve_spawn_point(self, preferred_index)
    if not self.spawn_registration_complete or #self.spawn_points == 0 then
        return nil, nil
    end

    if preferred_index
    and preferred_index >= 1
    and preferred_index <= #self.spawn_points
    and not self.reserved_spawn_points[preferred_index] then
        self.reserved_spawn_points[preferred_index] = true

        print("[SPAWNER] Reserved server-assigned spawn point: "
        .. preferred_index)

        return preferred_index, self.spawn_points[preferred_index]
    end

    local available = {}

    for index = 1, #self.spawn_points do
        if not self.reserved_spawn_points[index] then
            available[#available + 1] = index
        end
    end

    if #available == 0 then
        return nil, nil
    end

    local selected_index = available[math.random(1, #available)]
    self.reserved_spawn_points[selected_index] = true

    print("[SPAWNER] Reserved spawn point: " .. selected_index)

    return selected_index, self.spawn_points[selected_index]
end

local function release_spawn_point(self, index)
    if not index then
        return
    end

    if self.reserved_spawn_points[index] then
        self.reserved_spawn_points[index] = nil

        print("[SPAWNER] Released spawn point: " .. tostring(index))
    end
end

-- ============================================================
-- Battle menu state
-- ============================================================

local function set_battle_menu_state(self, is_open)
    self.battle_menu_open = is_open == true

    if not self.spawned or not self.tank_ids then
        return
    end

    -- tank_ids contains the objects created for the local tank
    -- collection only. Remote tanks are stored separately.
    for _, object_id in pairs(self.tank_ids) do
        if object_id then
            pcall(function()
                msg.post(object_id, "battle_menu_state", {
                    open = self.battle_menu_open
                })
            end)
        end
    end
end

-- ============================================================
-- Local player tank
-- ============================================================

local function spawn_tank(self)
    if not self.spawn_registration_complete or not self.network_ready then
        return false
    end
    if self.has_spawned_once and not self.respawn_authorized then
        print("[SPAWNER] Respawn not authorized by server")
        return false
    end
    if #self.spawn_points == 0 then
        print("[SPAWNER] ERROR: No spawn points registered")
        return false
    end

    local preferred_index = self.assigned_spawn_index ~= nil and (self.assigned_spawn_index + 1) or nil
    local point_index, point = reserve_spawn_point(self, preferred_index)
    if not point_index or not point then
        print("[SPAWNER] No free spawn points. Retrying later")
        return false
    end
    if preferred_index and point_index ~= preferred_index then
        print("[SPAWNER] WARNING: Assigned marker unavailable; using marker " .. point_index)
    end
    if not point.position or not point.rotation then
        print("[SPAWNER] ERROR: Invalid spawn point transform")
        release_spawn_point(self, point_index)
        return false
    end

    local hull_id, turret_id = load_garage_loadout()
    self.spawn_in_progress = true
    create_configured_tank(self, point.position, point.rotation, hull_id, turret_id, true,
    function(success, result)
        self.spawn_in_progress = false
        if not success then
            print("[SPAWNER] ERROR: Configured tank spawn failed: " .. tostring(result))
            release_spawn_point(self, point_index)
            self.timer = 1
            return
        end
        if not self.network_ready then
            pcall(go.delete, result.root_id, true)
            release_spawn_point(self, point_index)
            return
        end

        self.tank_ids = result.ids
        self.tank_root = result.root_id
        self.tank_container = result.container_id
        self.tank_turret = result.turret_id
        self.current_spawn_index = point_index
        self.spawned = true
        self.has_spawned_once = true
        self.respawn_authorized = false
        self.respawn_requested = false
        self.selected_hull_id = hull_id
        self.selected_turret_id = turret_id

        msg.post(self.tank_root, "set_player_name", {
            name = self.network_player_id or "PLAYER",
            hide_name = true
        })
        set_battle_menu_state(self, self.battle_menu_open)

        local target_url = msg.url("main", self.tank_root, nil)
        local ok_message, message_error = pcall(function()
            msg.post(CAMERA_URL, "set_target", { target = target_url })
        end)
        if not ok_message then
            print("[SPAWNER] WARNING: Camera target message failed: " .. tostring(message_error))
        end

        msg.post(NETWORK_MANAGER_URL, "network_set_loadout", {
            hull_id = hull_id,
            turret_id = turret_id
        })

        print("[SPAWNER] Local tank spawned at marker " .. point_index
        .. " (network player " .. tostring(self.network_player_id) .. ")"
        .. "; loadout=" .. hull_id .. "/" .. turret_id)
    end)

    return true
end

local function destroy_tank(self)
    if not self.tank_root then
        print("[SPAWNER] No tank instance to destroy")
        return false
    end

    sound.play("#death")

    pcall(function()
        msg.post(CAMERA_URL, "clear_target")
    end)

    msg.post(NETWORK_MANAGER_URL, "network_player_inactive")

    local old_root = self.tank_root

    local ok_delete, delete_error = pcall(function()
        go.delete(old_root, true)
    end)

    if not ok_delete then
        print("[SPAWNER] ERROR: Destroy failed: "
        .. tostring(delete_error))
        return false
    end

    release_spawn_point(self, self.current_spawn_index)

    self.tank_ids = nil
    self.tank_root = nil
    self.tank_container = nil
    self.tank_turret = nil
    self.current_spawn_index = nil
    self.spawned = false

    self.timer = self.spawn_delay
    self.respawn_requested = false
    self.respawn_authorized = false

    print("[SPAWNER] Tank destroyed; respawn scheduled")

    return true
end

-- ============================================================
-- Remote tank management
-- ============================================================

local function get_remote_tank(self, player_id)
    return self.remote_tanks[player_id]
end

local function register_remote_instance(player_id, ids, root_id)
    msg.post(NETWORK_MANAGER_URL, "network_remote_instance_registered", {
        player_id = player_id,
        root_id = root_id,
        ids = ids
    })
end

local function remove_remote_tank(self, player_id)
    local remote = self.remote_tanks[player_id]

    if not remote then
        return
    end

    self.remote_tanks[player_id] = nil

    if remote.root_id then
        pcall(function()
            go.delete(remote.root_id, true)
        end)
    end

    msg.post(NETWORK_MANAGER_URL, "network_remote_instance_unregistered", {
        player_id = player_id,
        root_id = remote.root_id,
        ids = remote.ids
    })

    print("[SPAWNER] Removed remote tank: " .. tostring(player_id))
end

local function clear_remote_tanks(self)
    local player_ids = {}

    for player_id in pairs(self.remote_tanks) do
        player_ids[#player_ids + 1] = player_id
    end

    for _, player_id in ipairs(player_ids) do
        remove_remote_tank(self, player_id)
    end

    self.pending_remote_shots = {}
end

local function update_remote_tank(self, player_id, state)
    local remote = get_remote_tank(self, player_id)

    if not remote or not remote.root_id or remote.pending then
        return false
    end

    msg.post(remote.root_id, "network_remote_state", {
        x = state.x,
        y = state.y,
        body_angle = state.body_angle or 0,
        turret_angle = state.turret_angle or 0,
        state_seq = state.state_seq
    })

    return true
end

local function create_remote_tank(self, player_id, state)
    if type(player_id) ~= "string" or player_id == "" then
        print("[SPAWNER] ERROR: Invalid remote player ID")
        return false
    end

    if player_id == self.network_player_id then
        return false
    end

    if type(state) ~= "table"
    or type(state.x) ~= "number"
    or type(state.y) ~= "number" then
        return false
    end

    print("[SPAWNER] Remote loadout received: "
    .. player_id
    .. " hull=" .. tostring(state.hull_id)
    .. " turret=" .. tostring(state.turret_id))

    local existing = self.remote_tanks[player_id]

    -- Check whether the remote player's loadout has changed.
    if existing and not existing.pending then
        local new_hull_id = normalize_hull_id(state.hull_id)
        local new_turret_id = normalize_turret_id(state.turret_id)

        if existing.hull_id ~= new_hull_id
        or existing.loadout_turret_id ~= new_turret_id then

            print("[SPAWNER] Remote loadout changed for "
            .. player_id .. ": "
            .. tostring(existing.hull_id) .. "/"
            .. tostring(existing.loadout_turret_id)
            .. " -> "
            .. new_hull_id .. "/"
            .. new_turret_id)

            remove_remote_tank(self, player_id)
            existing = nil
        end
    end

    if existing then
        update_remote_tank(self, player_id, state)
        return true
    end

    local remote_hull_id = normalize_hull_id(state.hull_id)
    local remote_turret_id = normalize_turret_id(state.turret_id)

    local position = vmath.vector3(state.x, state.y, 0)
    local rotation = vmath.quat_rotation_z(
    tonumber(state.body_angle) or 0
)

-- Reserve the player key while resources are loading.
self.remote_tanks[player_id] = {
    player_id = player_id,
    pending = true
}

create_configured_tank(
self,
position,
rotation,
remote_hull_id,
remote_turret_id,
false,
function(success, result)
    if not success then
        if self.remote_tanks[player_id]
        and self.remote_tanks[player_id].pending then
            self.remote_tanks[player_id] = nil
        end

        print("[SPAWNER] ERROR: Failed to create remote tank for "
        .. player_id .. ": " .. tostring(result))
        return
    end

    -- The player may have disconnected while resources loaded.
    if not self.remote_tanks[player_id]
    or not self.remote_tanks[player_id].pending then
        pcall(go.delete, result.root_id, true)
        return
    end

    local remote = {
        player_id = player_id,
        root_id = result.root_id,
        container_id = result.container_id,
        turret_id = result.turret_id,
        hull_id = remote_hull_id,
        loadout_turret_id = remote_turret_id,
        ids = result.ids,
        pending = false
    }

    self.remote_tanks[player_id] = remote

    msg.post(remote.root_id, "set_player_name", {
        name = player_id,
        hide_name = false
    })

    register_remote_instance(
    player_id,
    remote.ids,
    remote.root_id
)

update_remote_tank(self, player_id, state)

print("[SPAWNER] Created remote tank for "
.. player_id
.. " with loadout="
.. remote_hull_id .. "/" .. remote_turret_id)

local pending = self.pending_remote_shots[player_id]

if pending then
    self.pending_remote_shots[player_id] = nil

    for _, shot in ipairs(pending) do
        self:spawn_remote_shot(player_id, shot)
    end
end
end
)

return true
end

-- ============================================================
-- Remote visual projectiles
-- ============================================================

local function spawn_remote_shot(self, player_id, shot)
local remote = get_remote_tank(self, player_id)

if not remote or remote.pending then
local pending = self.pending_remote_shots[player_id]

if not pending then
pending = {}
self.pending_remote_shots[player_id] = pending
end

if #pending < MAX_PENDING_SHOTS then
pending[#pending + 1] = shot
end

return false
end

if not remote.turret_id then
print("[SPAWNER] WARNING: Remote tank has no turret: "
.. tostring(player_id))
return false
end

-- Prefer the authoritative shot transform sent by the server.
local x = tonumber(shot.x)
local y = tonumber(shot.y)
local z = tonumber(shot.z) or 0
local angle = tonumber(shot.angle)

-- Fallback for older server messages that lack coordinates.
if x == nil or y == nil or angle == nil then
local turret_id = remote.turret_id

local ok_position, turret_position =
pcall(go.get_world_position, turret_id)

local ok_rotation, turret_rotation =
pcall(go.get_world_rotation, turret_id)

if not ok_position or not ok_rotation then
print("[SPAWNER] WARNING: Cannot read remote turret transform")
return false
end

local direction = vmath.rotate(
turret_rotation,
vmath.vector3(0, 1, 0)
)

local muzzle_distance = 50

local ok_distance, distance = pcall(
go.get,
"muzzle_distance",
msg.url("main", turret_id, nil)
)

if ok_distance and type(distance) == "number" then
muzzle_distance = distance
end

local fallback_position =
turret_position + direction * muzzle_distance

x = fallback_position.x
y = fallback_position.y
z = fallback_position.z

local fallback_direction = vmath.rotate(
turret_rotation,
vmath.vector3(0, 1, 0)
)

angle = math.atan2(
fallback_direction.y,
fallback_direction.x
)
end

local spawn_position = vmath.vector3(x, y, z)

-- Server angle is measured from +X. Projectiles travel along +Y.
local spawn_rotation = vmath.quat_rotation_z(
angle - math.pi * 0.5
)

local muzzle_url = msg.url(
"main",
remote.turret_id,
hash("muzzle_flash_factory")
)

local projectile_url = msg.url(
"main",
remote.turret_id,
hash("projectile_factory")
)

local ok_flash, flash_id = pcall(function()
return factory.create(
muzzle_url,
spawn_position,
spawn_rotation
)
end)

if ok_flash and flash_id then
msg.post(flash_id, "play_effect")
else
print("[SPAWNER] WARNING: Remote muzzle flash creation failed: "
.. tostring(flash_id))
end

local properties = {
speed = 750,
lifetime = 1.5,
damage = 0,
min_damage = 0,
owner_group = GROUP_TANK,
owner_id = remote.root_id,
is_visual_only = true
}

local ok_projectile, projectile_id = pcall(function()
return factory.create(
projectile_url,
spawn_position,
spawn_rotation,
properties
)
end)

if not ok_projectile or not projectile_id then
print("[SPAWNER] WARNING: Remote projectile creation failed: "
.. tostring(projectile_id))
return false
end

if type(shot.shot_id) == "string" then
msg.post(projectile_id, "set_shot_id", {
shot_id = shot.shot_id
})
end

print("[SPAWNER] Remote shot spawned for " .. tostring(player_id)
.. " at (" .. tostring(x) .. ", " .. tostring(y)
.. "), angle=" .. tostring(angle))

return true
end

-- ============================================================
-- Lifecycle
-- ============================================================

function init(self)
self.spawn_points = {}
self.reserved_spawn_points = {}
self.spawn_registration_complete = false
self.registration_timer = REGISTRATION_WAIT

self.timer = self.spawn_delay
self.spawned = false
self.tank_ids = nil
self.tank_root = nil
self.tank_container = nil
self.tank_turret = nil
self.spawn_in_progress = false
self.current_spawn_index = nil

self.network_ready = false
self.network_player_id = nil
self.assigned_spawn_index = nil
self.selected_hull_id, self.selected_turret_id = load_garage_loadout()

self.has_spawned_once = false
self.respawn_requested = false
self.respawn_authorized = false

self.battle_menu_open = false

self.remote_tanks = {}
self.pending_remote_shots = {}

self.spawn_remote_shot = spawn_remote_shot

math.randomseed(os.time())

print("[DEBUG] Spawner script URL: " .. tostring(msg.url()))
print("[DEBUG] Tank collection factory URL: " .. tostring(TANK_COLLECTION_FACTORY_URL))
print("[DEBUG] Camera URL: " .. tostring(CAMERA_URL))

msg.post(".", "acquire_input_focus")

print("[SPAWNER] Waiting for spawn point registration and network assignment")
end

function update(self, dt)
if not self.spawn_registration_complete then
self.registration_timer = self.registration_timer - dt

if self.registration_timer <= 0 then
self.spawn_registration_complete = true

print("[SPAWNER] Registration finished. Points: "
.. #self.spawn_points)

self.timer = self.spawn_delay
else
return
end
end

-- Remote tank updates are independent of local spawning.
if self.spawned or self.spawn_in_progress then
return
end

if not self.network_ready then
return
end

if self.has_spawned_once and not self.respawn_authorized then
if self.respawn_requested then
return
end

self.timer = self.timer - dt

if self.timer <= 0 then
self.respawn_requested = true

msg.post(NETWORK_MANAGER_URL, "network_request_respawn")

print("[SPAWNER] Respawn requested from server")
end

return
end

self.timer = self.timer - dt

if self.timer <= 0 then
if not spawn_tank(self) then
self.timer = 1
end
end
end

function on_message(self, message_id, message, sender)
-- --------------------------------------------------------
-- Battle menu
-- --------------------------------------------------------

if message_id == hash("battle_menu_state") then
set_battle_menu_state(self, message.open == true)
return
end

if message_id == hash("chat_state") then
if self.spawned and self.tank_ids then
for _, object_id in pairs(self.tank_ids) do
if object_id then
pcall(function()
msg.post(object_id, "chat_state", {
open = message.open == true
})
end)
end
end
end
return
end

-- --------------------------------------------------------
-- Spawn point registration
-- --------------------------------------------------------

if message_id == hash("register_spawn_point") then
if message.position and message.rotation then
self.spawn_points[#self.spawn_points + 1] = {
position = message.position,
rotation = message.rotation
}

print("[SPAWNER] Registered spawn point. Total: "
.. #self.spawn_points)
else
print("[SPAWNER] ERROR: Invalid spawn point message")
end

elseif message_id == hash("request_spawn_point") then
-- Backwards compatibility with the legacy bot_spawner.
local point_index, point = reserve_spawn_point(self)

if point_index and point then
msg.post(sender, "spawn_point_assigned", {
index = point_index,
position = point.position,
rotation = point.rotation
})
else
msg.post(sender, "spawn_point_unavailable")
end

elseif message_id == hash("spawn_registration_complete") then
self.spawn_registration_complete = true
self.timer = self.spawn_delay

print("[SPAWNER] Spawn point registration complete")

-- --------------------------------------------------------
-- Local player network state
-- --------------------------------------------------------

elseif message_id == hash("network_player_ready") then
self.network_ready = true
self.network_player_id = message.player_id
self.assigned_spawn_index = tonumber(message.spawn_index)

self.timer = self.spawn_delay

print("[SPAWNER] Server assignment received. Player: "
.. tostring(self.network_player_id)
.. ", zero-based spawn index: "
.. tostring(self.assigned_spawn_index))

elseif message_id == hash("network_disconnected") then
self.network_ready = false
self.respawn_requested = false

clear_remote_tanks(self)

print("[SPAWNER] Network disconnected; waiting for server")

elseif message_id == hash("network_respawn_accepted") then
if message.player_id ~= self.network_player_id then
print("[SPAWNER] Ignored respawn confirmation for another player")
return
end

self.respawn_authorized = true
self.respawn_requested = false
self.timer = 0

local index = tonumber(message.spawn_index)

if index ~= nil then
self.assigned_spawn_index = index
end

print("[SPAWNER] Server authorized respawn")

elseif message_id == hash("network_respawn_rejected") then
self.respawn_requested = false
self.respawn_authorized = false
self.timer = 0.5

print("[SPAWNER] Respawn rejected: " .. tostring(message.reason))

elseif message_id == hash("player_destroyed") then
if self.spawned and self.tank_root then
destroy_tank(self)
end

elseif message_id == hash("network_apply_damage") then
if self.spawned and self.tank_root then
msg.post(self.tank_root, "network_apply_damage", {
damage = message.damage,
killer_id = message.killer_id,
hit_x = message.hit_x,
hit_y = message.hit_y,
effects = message.effects or {},
critical = message.critical == true,
effect = message.effect or "",
status_tick = message.status_tick == true
})
else
print("[SPAWNER] Ignored network damage: no active local tank")
end

elseif message_id == hash("network_status_expired") then
if self.spawned and self.tank_root then
msg.post(self.tank_root, "network_status_expired", {
effect = message.effect or ""
})
end

elseif message_id == hash("release_spawn_point") then
release_spawn_point(self, message.index)

-- --------------------------------------------------------
-- Remote tank create/update/remove
-- --------------------------------------------------------

elseif message_id == hash("network_remote_player_state") then
local player_id = message.player_id

if player_id and player_id ~= self.network_player_id then
    -- create_remote_tank handles both:
    -- updating an existing tank and recreating it
    -- when its hull or turret loadout changes.
    create_remote_tank(self, player_id, message)
end

elseif message_id == hash("network_remote_player_remove") then
if message.player_id then
remove_remote_tank(self, message.player_id)
end

elseif message_id == hash("network_remote_players_clear") then
clear_remote_tanks(self)

-- --------------------------------------------------------
-- Remote visual shots
-- --------------------------------------------------------

elseif message_id == hash("network_remote_shot") then
if message.player_id
and message.player_id ~= self.network_player_id then
spawn_remote_shot(self, message.player_id, message)
end
end
end

function on_input(self, action_id, action)
if action_id == hash("kill_tank") and action.pressed then
if self.spawned then
destroy_tank(self)
else
print("[SPAWNER] No spawned tank to destroy")
end

return true
end

return false
end

function final(self)
clear_remote_tanks(self)
end