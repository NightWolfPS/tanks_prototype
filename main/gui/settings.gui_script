
-- settings.gui_script
-- BATTLEFRONT / IRONGRID Settings
-- Defold 1.13.1

local SCALE = 36 / 72

local COLORS = {
    background = vmath.vector4(0.025, 0.04, 0.045, 1),
    header = vmath.vector4(0.025, 0.04, 0.045, 1),
    panel = vmath.vector4(0.045, 0.065, 0.07, 1),
    panel_inner = vmath.vector4(0.035, 0.052, 0.057, 1),
    button = vmath.vector4(0.07, 0.12, 0.13, 1),
    active = vmath.vector4(0.08, 0.27, 0.29, 1),
    accent = vmath.vector4(0.20, 0.82, 0.88, 1),
    text = vmath.vector4(0.92, 0.95, 0.94, 1),
    muted = vmath.vector4(0.43, 0.58, 0.59, 1),
    border = vmath.vector4(0.12, 0.28, 0.30, 1)
}

local function add_node(self, node)
    self.nodes[#self.nodes + 1] = node
    return node
end

local function make_box(self, x, y, w, h, color, z)
    local node = gui.new_box_node(
        vmath.vector3(x, y, 0),
        vmath.vector3(w, h, 0)
    )

    gui.set_color(node, color)
    return add_node(self, node)
end

local function make_text(self, x, y, value, size, color, z)
    local node = gui.new_text_node(
        vmath.vector3(x, y, 1),
        tostring(value)
    )

    local scale = size * SCALE * self.scale

    gui.set_scale(node, vmath.vector3(scale, scale, 1))
    gui.set_color(node, color or COLORS.text)

    return add_node(self, node)
end

local function add_button(self, id, text, x, y, w, h, active)
    local color = active and COLORS.active or COLORS.button

    local node = make_box(
        self, x, y, w, h, color, 0.25
    )

    make_text(
        self, x, y, text, 0.48,
        active and COLORS.accent or COLORS.text,
        0.8
    )

    self.buttons[#self.buttons + 1] = {
        id = id,
        node = node
    }

    return node
end

local function clear_nodes(self)
    for _, node in ipairs(self.nodes or {}) do
        gui.delete_node(node)
    end

    self.nodes = {}
    self.buttons = {}
end

local function build_header(self)
    local w = self.width
    local h = self.height
    local s = self.scale
    local y = h - 25 * s

    make_box(
        self, w * 0.5, y,
        w, 50 * s,
        COLORS.header, -0.5
    )

    make_text(
        self, 76 * s, y,
        "BATTLEFRONT",
        0.9,
        COLORS.accent,
        0.9
    )

    local navigation = {
        {"ЗАДАЧИ", "tasks", 0.23},
        {"ДРУЗЬЯ", "friends", 0.33},
        {"В БОЙ", "battle", 0.43},
        {"ГАРАЖ", "garage", 0.53},
        {"МАГАЗИН", "shop", 0.63}
    }

    for _, item in ipairs(navigation) do
        add_button(
            self,
            item[2],
            item[1],
            w * item[3],
            y,
            92 * s,
            30 * s,
            false
        )
    end

    add_button(
        self, "settings",
        "S",
        w - 92 * s, y,
        34 * s, 30 * s,
        true
    )

    add_button(
        self, "close",
        "X",
        w - 48 * s, y,
        34 * s, 30 * s,
        false
    )
end

local function build_controls(self, x, y, w, h)
    local rows = {
        {"Движение вперёд", "↑"},
        {"Движение назад", "↓"},
        {"Поворот корпуса влево", "←"},
        {"Поворот корпуса вправо", "→"},
        {"Поворот башни влево", "Z"},
        {"Поворот башни вправо", "X"},
        {"Огонь", "ПРОБЕЛ"},
        {"Чат", "ENTER"},
        {"Пауза", "ESC"},
        {"Статистика матча", "TAB"}
    }

    local top = y + h * 0.29
    local step = math.min(34 * self.scale, h * 0.075)

    for i, item in ipairs(rows) do
        local row_y = top - (i - 1) * step

        if i % 2 == 0 then
            make_box(
                self,
                x, row_y,
                w * 0.88, step * 0.88,
                COLORS.panel_inner,
                0
            )
        end

        make_text(
            self,
            x - w * 0.39,
            row_y,
            item[1],
            0.46,
            COLORS.text,
            0.8
        )

        make_box(
            self,
            x + w * 0.34,
            row_y,
            78 * self.scale,
            23 * self.scale,
            COLORS.button,
            0.2
        )

        make_text(
            self,
            x + w * 0.34,
            row_y,
            item[2],
            0.39,
            COLORS.accent,
            0.9
        )
    end
end

local function build_sound(self, x, y, w, h)
    local rows = {
        {"Общая громкость", 80},
        {"Музыка", 55},
        {"Звуковые эффекты", 75},
        {"Эмбиент карт", 40}
    }

    local top = y + h * 0.20
    local step = 62 * self.scale

    for i, item in ipairs(rows) do
        local row_y = top - (i - 1) * step

        make_text(
            self,
            x - w * 0.38,
            row_y,
            item[1],
            0.52,
            COLORS.text
        )

        local bar_x = x + w * 0.12
        local bar_w = w * 0.38

        make_box(
            self,
            bar_x,
            row_y,
            bar_w,
            5 * self.scale,
            COLORS.button,
            0.2
        )

        local progress = item[2] / 100

        make_box(
            self,
            bar_x - bar_w * 0.5 + bar_w * progress * 0.5,
            row_y,
            bar_w * progress,
            5 * self.scale,
            COLORS.accent,
            0.3
        )

        make_box(
            self,
            bar_x - bar_w * 0.5 + bar_w * progress,
            row_y,
            12 * self.scale,
            12 * self.scale,
            COLORS.accent,
            0.4
        )

        make_text(
            self,
            x + w * 0.39,
            row_y,
            item[2] .. "%",
            0.45,
            COLORS.text
        )
    end
end

local function build(self)
    clear_nodes(self)

    self.width = gui.get_width()
    self.height = gui.get_height()

    self.scale = math.min(
        1,
        self.width / 1280,
        self.height / 720
    )

    local w = self.width
    local h = self.height
    local s = self.scale

    -- Фон.
    make_box(
        self,
        w * 0.5,
        h * 0.5,
        w, h,
        COLORS.background,
        -1
    )

    -- Постоянная шапка.
    build_header(self)

    -- Центральная панель.
    local panel_w = math.min(w * 0.58, 720 * s)
    local panel_h = math.min(h * 0.78, 560 * s)

    local panel_x = w * 0.5
    local panel_y = h * 0.47

    make_box(
        self,
        panel_x,
        panel_y,
        panel_w,
        panel_h,
        COLORS.border,
        -0.2
    )

    make_box(
        self,
        panel_x,
        panel_y,
        panel_w - 2 * s,
        panel_h - 2 * s,
        COLORS.panel,
        -0.1
    )

    -- Заголовок.
    make_text(
        self,
        panel_x - panel_w * 0.39,
        panel_y + panel_h * 0.40,
        "НАСТРОЙКИ",
        1.0,
        COLORS.text
    )

    -- Вкладки.
    local tab_y = panel_y + panel_h * 0.31

    add_button(
        self,
        "tab_controls",
        "УПРАВЛЕНИЕ",
        panel_x - 72 * s,
        tab_y,
        132 * s,
        30 * s,
        self.tab == "controls"
    )

    add_button(
        self,
        "tab_sound",
        "ЗВУК",
        panel_x + 85 * s,
        tab_y,
        100 * s,
        30 * s,
        self.tab == "sound"
    )

    -- Содержимое вкладки.
    local content_y = panel_y - panel_h * 0.04
    local content_h = panel_h * 0.65

    if self.tab == "sound" then
        build_sound(
            self,
            panel_x,
            content_y,
            panel_w,
            content_h
        )
    else
        build_controls(
            self,
            panel_x,
            content_y,
            panel_w,
            content_h
        )
    end

    -- Нижняя кнопка.
    add_button(
        self,
        "close",
        "ЗАКРЫТЬ",
        panel_x + panel_w * 0.34,
        panel_y - panel_h * 0.42,
        100 * s,
        30 * s,
        false
    )
end

local function activate(self, id)
    if id == "close" or id == "battle" then
        msg.post(
            "bootstrap:/scene_manager#scene_manager",
            "return_to_menu"
        )

    elseif id == "garage" then
        msg.post(
            "bootstrap:/scene_manager#scene_manager",
            "open_garage"
        )

    elseif id == "tab_controls" then
        self.tab = "controls"
        build(self)

    elseif id == "tab_sound" then
        self.tab = "sound"
        build(self)

    elseif id == "settings" then
        -- Уже открытая страница настроек.
        return

    else
        print("[SETTINGS] Placeholder: " .. tostring(id))
    end
end

function init(self)
    self.nodes = {}
    self.buttons = {}
    self.tab = "controls"
    self.pressed = nil

    print("[SETTINGS] Initializing GUI")

    build(self)

    msg.post(".", "acquire_input_focus")

    print("[SETTINGS] GUI initialized")
end

function final(self)
    clear_nodes(self)
    print("[SETTINGS] GUI finalized")
end

function update(self, dt)
    if gui.get_width() ~= self.width
    or gui.get_height() ~= self.height then
        build(self)
    end
end

function on_input(self, action_id, action)
    if action_id ~= hash("touch") or not action then
        return false
    end

    if action.pressed then
        self.pressed = nil

        for _, button in ipairs(self.buttons) do
            if gui.pick_node(
                button.node,
                action.x,
                action.y
            ) then
                self.pressed = button.id
                return true
            end
        end

        return false
    end

    if action.released and self.pressed then
        local pressed = self.pressed
        self.pressed = nil

        for _, button in ipairs(self.buttons) do
            if button.id == pressed
            and gui.pick_node(
                button.node,
                action.x,
                action.y
            ) then

                activate(self, pressed)
                return true
            end
        end
    end

    return false
end
