-- garage.gui_script
-- Defold 1.13.1

local COLORS = {
	background = vmath.vector4(0.035, 0.05, 0.06, 1),
	panel = vmath.vector4(0.08, 0.11, 0.12, 1),
	card = vmath.vector4(0.13, 0.17, 0.18, 1),
	selected = vmath.vector4(0.32, 0.24, 0.12, 1),
	accent = vmath.vector4(0.95, 0.65, 0.20, 1),
	text = vmath.vector4(0.94, 0.95, 0.91, 1),
	muted = vmath.vector4(0.58, 0.66, 0.65, 1),
}

local SAVE_PATH = "garage.save"

local MODULES = {
	hulls = {
		{
			id = "light_hull",
			name = "Light hull",
			description = "Основной корпус",
		},
	},

	turrets = {
		{
			id = "tank_turret",
			name = "tank_turret",
			description = "Обычная пушка",
		},
		{
			id = "twin_barrel_turret",
			name = "twin_barrel_turret",
			description = "Двуствольная пушка",
		},
	},
}

local CARD_WIDTH = 190
local CARD_HEIGHT = 105
local CARD_GAP = 14

local GARAGE_PREVIEW_URL =
msg.url("garage:/garage_preview#garage_preview")


local function update_preview(self)
	msg.post(GARAGE_PREVIEW_URL, "garage_preview_update", {
		hull_id = self.hull_id,
		turret_id = self.turret_id,
	})
end


local function create_box(position, size, color)
	local node = gui.new_box_node(position, size)
	gui.set_color(node, color)
	return node
end


local function create_text(position, value, scale, color)
	local node = gui.new_text_node(position, value)
	gui.set_scale(node, vmath.vector3(scale, scale, 1))
	gui.set_color(node, color)
	return node
end


local function add_node(self, node)
	self.nodes[#self.nodes + 1] = node
	return node
end


local function save_selection(self)
	local data = {
		hull_id = self.hull_id,
		turret_id = self.turret_id,
	}

	local ok, err = pcall(function()
		sys.save(SAVE_PATH, data)
	end)

	if not ok then
		print("[GARAGE] Failed to save selection: " .. tostring(err))
	end
end


local function load_selection(self)
	local ok, data = pcall(function()
		return sys.load(SAVE_PATH)
	end)

	if ok and type(data) == "table" then
		self.hull_id = data.hull_id or "light_hull"
		self.turret_id = data.turret_id or "twin_barrel_turret"
	else
		self.hull_id = "light_hull"
		self.turret_id = "twin_barrel_turret"
	end

	local hull_valid = false
	for _, module in ipairs(MODULES.hulls) do
		if module.id == self.hull_id then
			hull_valid = true
			break
		end
	end

	local turret_valid = false
	for _, module in ipairs(MODULES.turrets) do
		if module.id == self.turret_id then
			turret_valid = true
			break
		end
	end

	if not hull_valid then
		self.hull_id = MODULES.hulls[1].id
	end

	if not turret_valid then
		self.turret_id = MODULES.turrets[1].id
	end
end


local function destroy_nodes(self)
	for _, node in ipairs(self.nodes or {}) do
		gui.delete_node(node)
	end

	self.nodes = {}
	self.cards = {}
	self.buttons = {}
end


local function create_button(self, id, label, x, y, width, height)
	local box = add_node(self, create_box(
	vmath.vector3(x, y, 0),
	vmath.vector3(width, height, 0),
	COLORS.card
))

local text = add_node(self, create_text(
vmath.vector3(x, y, 0.1),
label,
self.scale,
COLORS.text
))

self.buttons[#self.buttons + 1] = {
id = id,
box = box,
}

return box, text
end


local function build_cards(self)
local modules = MODULES[self.section]

local width = CARD_WIDTH * self.scale
local height = CARD_HEIGHT * self.scale
local gap = CARD_GAP * self.scale
local y = self.height * 0.37

local visible_count = math.max(
1,
math.floor((self.width * 0.72) / (width + gap))
)

local first = self.scroll_index + 1
local last = math.min(#modules, first + visible_count - 1)

local count = last - first + 1
local total_width = count * width + math.max(0, count - 1) * gap
local x = self.width * 0.5 - total_width * 0.5 + width * 0.5

for i = first, last do
local module = modules[i]

local selected_id
if self.section == "hulls" then
selected_id = self.hull_id
else
selected_id = self.turret_id
end

local color = module.id == selected_id
and COLORS.selected
or COLORS.card

local box = add_node(self, create_box(
vmath.vector3(x, y, 0),
vmath.vector3(width, height, 0),
color
))

add_node(self, create_text(
vmath.vector3(x, y + 12 * self.scale, 1),
module.name,
0.65 * self.scale,
COLORS.text
))

add_node(self, create_text(
vmath.vector3(x, y - 18 * self.scale, 1),
module.description,
0.48 * self.scale,
COLORS.muted
))

self.cards[#self.cards + 1] = {
id = module.id,
box = box,
}

x = x + width + gap
end
end


local function build_garage(self)
destroy_nodes(self)

self.width = gui.get_width()
self.height = gui.get_height()
self.scale = math.min(1, self.width / 1280, self.height / 720)

local center_x = self.width * 0.5
local center_y = self.height * 0.59

local preview_w = 360 * self.scale
local preview_h = 230 * self.scale

local left = center_x - preview_w * 0.5
local right = center_x + preview_w * 0.5
local bottom = center_y - preview_h * 0.5
local top = center_y + preview_h * 0.5

-- Фон за пределами области превью.
add_node(self, create_box(
vmath.vector3(self.width * 0.5, (top + self.height) * 0.5, 1),
vmath.vector3(self.width, self.height - top, 0),
COLORS.background
))

add_node(self, create_box(
vmath.vector3(self.width * 0.5, bottom * 0.5, 1),
vmath.vector3(self.width, bottom, 0),
COLORS.background
))

add_node(self, create_box(
vmath.vector3(left * 0.5, center_y, 1),
vmath.vector3(left, preview_h, 0),
COLORS.background
))

add_node(self, create_box(
vmath.vector3((right + self.width) * 0.5, center_y, 1),
vmath.vector3(self.width - right, preview_h, 0),
COLORS.background
))

-- Большая панель с отверстием под превью.
-- Не создаём непрозрачный прямоугольник поверх центра.
add_node(self, create_box(
vmath.vector3(self.width * 0.5, self.height * 0.5, 0.9),
vmath.vector3(self.width * 0.92, self.height * 0.88, 0),
vmath.vector4(
COLORS.panel.x,
COLORS.panel.y,
COLORS.panel.z,
0.45
)
))

-- Прозрачная область превью.
add_node(self, create_box(
vmath.vector3(center_x, center_y, 1.1),
vmath.vector3(preview_w, preview_h, 0),
vmath.vector4(0.02, 0.025, 0.03, 0.15)
))

add_node(self, create_text(
vmath.vector3(center_x, self.height * 0.91, 1),
"GARAGE",
1.5 * self.scale,
COLORS.accent
))

add_node(self, create_text(
vmath.vector3(center_x, center_y + preview_h * 0.5 - 18 * self.scale, 2),
"TANK PREVIEW",
0.65 * self.scale,
COLORS.muted
))

create_button(
self,
"return",
"BACK TO MENU",
self.width * 0.15,
self.height * 0.09,
190 * self.scale,
44 * self.scale
)

create_button(
self,
"hulls",
"HULLS",
self.width * 0.37,
self.height * 0.78,
150 * self.scale,
42 * self.scale
)

create_button(
self,
"turrets",
"TURRETS",
self.width * 0.63,
self.height * 0.78,
150 * self.scale,
42 * self.scale
)

create_button(
self,
"scroll_left",
"<",
self.width * 0.12,
self.height * 0.37,
45 * self.scale,
55 * self.scale
)

create_button(
self,
"scroll_right",
">",
self.width * 0.88,
self.height * 0.37,
45 * self.scale,
55 * self.scale
)

build_cards(self)
update_preview(self)
end


local function activate_button(self, id)
if id == "return" then
msg.post(
"bootstrap:/scene_manager#scene_manager",
"return_to_menu"
)
return
end

if id == "hulls" or id == "turrets" then
self.section = id
self.scroll_index = 0
build_garage(self)
return
end

if id == "scroll_left" then
self.scroll_index = math.max(0, self.scroll_index - 1)
build_garage(self)
return
end

if id == "scroll_right" then
local modules = MODULES[self.section]

local visible_count = math.max(
1,
math.floor(
(self.width * 0.72) /
(CARD_WIDTH * self.scale + CARD_GAP * self.scale)
)
)

self.scroll_index = math.min(
math.max(0, #modules - visible_count),
self.scroll_index + 1
)

build_garage(self)
end
end


function init(self)
self.nodes = {}
self.cards = {}
self.buttons = {}
self.section = "hulls"
self.scroll_index = 0
self.pressed = nil

load_selection(self)
build_garage(self)

msg.post(".", "acquire_input_focus")
print("[GARAGE] Initialized")
end


function final(self)
destroy_nodes(self)
end


function on_input(self, action_id, action)
if action_id ~= hash("touch") or not action then
return false
end

if action.pressed then
self.pressed = nil

for _, button in ipairs(self.buttons) do
if gui.pick_node(button.box, action.x, action.y) then
self.pressed = {
type = "button",
id = button.id,
}
return true
end
end

for _, card in ipairs(self.cards) do
if gui.pick_node(card.box, action.x, action.y) then
self.pressed = {
type = "card",
id = card.id,
}
return true
end
end

return false
end

if action.released and self.pressed then
local pressed = self.pressed
self.pressed = nil

if pressed.type == "button" then
for _, button in ipairs(self.buttons) do
if button.id == pressed.id
and gui.pick_node(button.box, action.x, action.y) then
activate_button(self, pressed.id)
return true
end
end

elseif pressed.type == "card" then
for _, card in ipairs(self.cards) do
if card.id == pressed.id
and gui.pick_node(card.box, action.x, action.y) then

if self.section == "hulls" then
self.hull_id = card.id
else
self.turret_id = card.id
end

save_selection(self)
build_garage(self)
return true
end
end
end
end

return false
end