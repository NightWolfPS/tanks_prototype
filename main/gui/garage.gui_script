-- garage.gui_script
-- Defold 1.13.1

local TEXT_SCALE = 36 / 72 -- Компенсация увеличенного размера шрифта (72 px вместо 32 px).
local COLORS = {
	background = vmath.vector4(0.035, 0.05, 0.06, 1),
	panel = vmath.vector4(0.08, 0.11, 0.12, 1),
	card = vmath.vector4(0.13, 0.17, 0.18, 1),
	selected = vmath.vector4(0.32, 0.24, 0.12, 1),
	accent = vmath.vector4(0.95, 0.65, 0.20, 1),
	text = vmath.vector4(0.94, 0.95, 0.91, 1),
	muted = vmath.vector4(0.58, 0.66, 0.65, 1),
}

local SAVE_PATH = "garage.save"

local MODULES = {
	hulls = {
		{
			id = "light_hull",
			name = "Лёгкий корпус",
			description = "Легкий корпус",
		},
		{
			id = "weight_hull",
			name = "Тяжёлый корпус",
			description = "Тяжелый корпус",
		},
		{
			id = "middle_hull",
			name = "Средний корпус",
			description = "Средний корпус",
		},
	},

	turrets = {
		{
			id = "tank_turret",
			name = "Обычная пушка",
			description = "Обычная пушка",
		},
		{
			id = "twin_barrel_turret",
			name = "Двуствольная пушка",
			description = "Двуствольная пушка",
		},
		{
			id = "heavy_turret",
			name = "Тяжёлая пушка",
			description = "Тяжелая пушка",
		},
	},
}

local CARD_WIDTH = 190
local CARD_HEIGHT = 105
local CARD_GAP = 14

local GARAGE_PREVIEW_URL =
msg.url("garage:/garage_preview#garage_preview")


local function update_preview(self)
	msg.post(GARAGE_PREVIEW_URL, "garage_preview_update", {
		hull_id = self.hull_id,
		turret_id = self.turret_id,
	})
end


local function create_box(position, size, color)
	local node = gui.new_box_node(position, size)
	gui.set_color(node, color)
	return node
end


local function create_text(position, value, scale, color)
	local node = gui.new_text_node(position, value)
	gui.set_scale(node, vmath.vector3(scale * TEXT_SCALE, scale * TEXT_SCALE, 1))
	gui.set_color(node, color)
	return node
end


local function add_node(self, node)
	self.nodes[#self.nodes + 1] = node
	return node
end


local function save_selection(self)
	local data = {
		hull_id = self.hull_id,
		turret_id = self.turret_id,
	}

	local ok, err = pcall(function()
		sys.save(SAVE_PATH, data)
	end)

	if not ok then
		print("[GARAGE] Failed to save selection: " .. tostring(err))
	end
end


local function load_selection(self)
	local ok, data = pcall(function()
		return sys.load(SAVE_PATH)
	end)

	if ok and type(data) == "table" then
		self.hull_id = data.hull_id or "light_hull"
		self.turret_id = data.turret_id or "twin_barrel_turret"
	else
		self.hull_id = "light_hull"
		self.turret_id = "twin_barrel_turret"
	end

	local hull_valid = false
	for _, module in ipairs(MODULES.hulls) do
		if module.id == self.hull_id then
			hull_valid = true
			break
		end
	end

	local turret_valid = false
	for _, module in ipairs(MODULES.turrets) do
		if module.id == self.turret_id then
			turret_valid = true
			break
		end
	end

	if not hull_valid then
		self.hull_id = MODULES.hulls[1].id
	end

	if not turret_valid then
		self.turret_id = MODULES.turrets[1].id
	end
end


local function destroy_nodes(self)
	for _, node in ipairs(self.nodes or {}) do
		gui.delete_node(node)
	end

	self.nodes = {}
	self.cards = {}
	self.buttons = {}
end


local function create_button(self, id, label, x, y, width, height)
	local box = add_node(self, create_box(
	vmath.vector3(x, y, 0),
	vmath.vector3(width, height, 0),
	COLORS.card
))

local text = add_node(self, create_text(
vmath.vector3(x, y, 0.1),
label,
self.scale,
COLORS.text
))

self.buttons[#self.buttons + 1] = {
id = id,
box = box,
}

return box, text
end


local function build_cards(self)
local modules = MODULES[self.section]

local width = CARD_WIDTH * self.scale
local height = CARD_HEIGHT * self.scale
local gap = CARD_GAP * self.scale
local y = self.height * 0.32

local visible_count = math.max(
1,
math.floor((self.width * 0.72) / (width + gap))
)

local first = self.scroll_index + 1
local last = math.min(#modules, first + visible_count - 1)

local count = last - first + 1
local total_width = count * width + math.max(0, count - 1) * gap
local x = self.width * 0.5 - total_width * 0.5 + width * 0.5

for i = first, last do
local module = modules[i]

local selected_id
if self.section == "hulls" then
selected_id = self.hull_id
else
selected_id = self.turret_id
end

local color = module.id == selected_id
and COLORS.selected
or COLORS.card

local box = add_node(self, create_box(
vmath.vector3(x, y, 0),
vmath.vector3(width, height, 0),
color
))

add_node(self, create_text(
vmath.vector3(x, y + 12 * self.scale, 1),
module.name,
0.65 * self.scale,
COLORS.text
))

add_node(self, create_text(
vmath.vector3(x, y - 18 * self.scale, 1),
module.description,
0.48 * self.scale,
COLORS.muted
))

self.cards[#self.cards + 1] = {
id = module.id,
box = box,
}

x = x + width + gap
end
end


local function build_garage(self)
	destroy_nodes(self)

	self.width = gui.get_width()
	self.height = gui.get_height()
	self.scale = math.min(1, self.width / 1280, self.height / 720)

	local center_x = self.width * 0.5

	-- Размеры и положение карточки описания.
	local info_x = self.width * 0.25
	local info_y = self.height * 0.64
	local info_w = self.width * 0.39
	local info_h = self.height * 0.40

	-- Квадратная область превью.
	-- Центр соответствует положению объекта превью по X.
	local preview_size = info_h
	local preview_x = 940 * self.scale
	local preview_y = info_y

	local left = preview_x - preview_size * 0.5
	local right = preview_x + preview_size * 0.5
	local bottom = preview_y - preview_size * 0.5
	local top = preview_y + preview_size * 0.5

	-- Фон за пределами области превью.
	add_node(self, create_box(
		vmath.vector3(self.width * 0.5, (top + self.height) * 0.5, 1),
		vmath.vector3(self.width, self.height - top, 0),
		COLORS.background
	))

	add_node(self, create_box(
		vmath.vector3(self.width * 0.5, bottom * 0.5, 1),
		vmath.vector3(self.width, bottom, 0),
		COLORS.background
	))

	add_node(self, create_box(
		vmath.vector3(left * 0.5, preview_y, 1),
		vmath.vector3(left, preview_size, 0),
		COLORS.background
	))

	add_node(self, create_box(
		vmath.vector3((right + self.width) * 0.5, preview_y, 1),
		vmath.vector3(self.width - right, preview_size, 0),
		COLORS.background
	))

	-- Большая панель с отверстием под превью.
	add_node(self, create_box(
		vmath.vector3(self.width * 0.5, self.height * 0.5, 0.9),
		vmath.vector3(self.width * 0.92, self.height * 0.88, 0),
		vmath.vector4(
			COLORS.panel.x,
			COLORS.panel.y,
			COLORS.panel.z,
			0.45
		)
	))

	-- Квадратная прозрачная область превью.
	add_node(self, create_box(
		vmath.vector3(preview_x, preview_y, 1),
		vmath.vector3(preview_size, preview_size, 0),
		vmath.vector4(0.02, 0.025, 0.03, 0.15)
	))

	-- Постоянная шапка IRONGRID.
	add_node(self, create_box(
		vmath.vector3(center_x, self.height - 24 * self.scale, 0.85),
		vmath.vector3(self.width, 48 * self.scale, 0),
		vmath.vector4(0.025, 0.04, 0.045, 1)
	))

	add_node(self, create_text(
		vmath.vector3(76 * self.scale, self.height - 24 * self.scale, 1),
		"BATTLEFRONT",
		0.9 * self.scale,
		vmath.vector4(0.20, 0.82, 0.88, 1)
	))

	local nav = {
		{"ЗАДАЧИ", self.width * 0.23},
		{"ДРУЗЬЯ", self.width * 0.33},
		{"ГЛАВНАЯ", self.width * 0.43},
		{"ГАРАЖ", self.width * 0.53},
		{"МАГАЗИН", self.width * 0.63}
	}

	for _, item in ipairs(nav) do
		local active = item[1] == "ГАРАЖ"

		local box = add_node(self, create_box(
			vmath.vector3(item[2], self.height - 24 * self.scale, 0.9),
			vmath.vector3(92 * self.scale, 30 * self.scale, 0),
			active and vmath.vector4(0.08, 0.27, 0.29, 1) or COLORS.card
		))

		add_node(self, create_text(
			vmath.vector3(item[2], self.height - 24 * self.scale, 1),
			item[1],
			0.48 * self.scale,
			active and vmath.vector4(0.25, 0.85, 0.9, 1) or COLORS.text
		))

		self.buttons[#self.buttons + 1] = {
			id = "nav_" .. item[1],
			box = box
		}
	end

	local gear = add_node(self, create_box(
		vmath.vector3(self.width - 92 * self.scale, self.height - 24 * self.scale, 0.9),
		vmath.vector3(34 * self.scale, 30 * self.scale, 0),
		COLORS.card
	))

	add_node(self, create_text(
		vmath.vector3(self.width - 92 * self.scale, self.height - 24 * self.scale, 1),
		"S",
		0.65 * self.scale,
		COLORS.text
	))

	self.buttons[#self.buttons + 1] = {
		id = "nav_settings",
		box = gear
	}

	local exit_box = add_node(self, create_box(
		vmath.vector3(self.width - 48 * self.scale, self.height - 24 * self.scale, 0.9),
		vmath.vector3(34 * self.scale, 30 * self.scale, 0),
		COLORS.card
	))

	add_node(self, create_text(
		vmath.vector3(self.width - 48 * self.scale, self.height - 24 * self.scale, 1),
		"<-",
		0.65 * self.scale,
		COLORS.text
	))

	self.buttons[#self.buttons + 1] = {
		id = "return",
		box = exit_box
	}

	-- Левая информационная карточка.
	local selected_module
	local selected_list = MODULES[self.section] or MODULES.hulls
	local selected_id = self.section == "hulls" and self.hull_id or self.turret_id

	for _, module in ipairs(selected_list) do
		if module.id == selected_id then
			selected_module = module
			break
		end
	end

	selected_module = selected_module or selected_list[1]

	add_node(self, create_box(
		vmath.vector3(info_x + 130, info_y, 0.45),
		vmath.vector3(info_w, info_h, 0),
		vmath.vector4(0.025, 0.045, 0.05, 0.92)
	))

	add_node(self, create_text(
		vmath.vector3(info_x - info_w * 0, info_y + info_h * 0.31, 1),
		selected_module.description,
		0.92 * self.scale,
		COLORS.text
	))

	add_node(self, create_text(
		vmath.vector3(info_x - info_w * 0, info_y + info_h * 0.18, 1),
		self.section == "hulls"
		and "Быстрый и манёвренный, но слабо защищённый"
		or "Установленное вооружение оператора",
		0.42 * self.scale,
		COLORS.muted
	))

	local stat_names = {"Броня", "Скорость", "Масса", "Здоровье"}

	for i, stat_name in ipairs(stat_names) do
		local sy = info_y + info_h * 0 - (i - 1) * 22 * self.scale

		add_node(self, create_text(
			vmath.vector3(info_x - info_w * 0.15, sy, 1),
			stat_name,
			0.43 * self.scale,
			COLORS.muted
		))

		add_node(self, create_box(
			vmath.vector3(info_x + info_w * 0.02, sy, 0.6),
			vmath.vector3(info_w * 0.20, 3 * self.scale, 0),
			COLORS.card
		))
	end

	-- Заголовок квадратной области превью.
	add_node(self, create_text(
		vmath.vector3(
			preview_x,
			top - 18 * self.scale,
			1
		),
		"TANK PREVIEW",
		0.65 * self.scale,
		COLORS.muted
	))

	create_button(
		self,
		"hulls",
		"HULLS",
		self.width * 0.37,
		self.height * 0.17,
		150 * self.scale,
		42 * self.scale
	)

	create_button(
		self,
		"turrets",
		"TURRETS",
		self.width * 0.63,
		self.height * 0.17,
		150 * self.scale,
		42 * self.scale
	)

	create_button(
		self,
		"scroll_left",
		"<",
		self.width * 0.12,
		self.height * 0.32,
		45 * self.scale,
		55 * self.scale
	)

	create_button(
		self,
		"scroll_right",
		">",
		self.width * 0.88,
		self.height * 0.32,
		45 * self.scale,
		55 * self.scale
	)

	build_cards(self)
	update_preview(self)
end


local function activate_button(self, id)
if id == "return" then
msg.post("bootstrap:/scene_manager#scene_manager", "return_to_menu")
return
elseif id == "nav_ГЛАВНАЯ" then
msg.post("bootstrap:/scene_manager#scene_manager", "return_to_menu")
return
elseif id == "nav_settings" then
msg.post("bootstrap:/scene_manager#scene_manager", "open_settings")
return
elseif id == "nav_ЗАДАЧИ" or id == "nav_ДРУЗЬЯ" or id == "nav_МАГАЗИН" then
print("[GARAGE] This section is a visual placeholder")
return
elseif id == "nav_ГАРАЖ" then
return
end

if id == "hulls" or id == "turrets" then
self.section = id
self.scroll_index = 0
build_garage(self)
return
end

if id == "scroll_left" then
self.scroll_index = math.max(0, self.scroll_index - 1)
build_garage(self)
return
end

if id == "scroll_right" then
local modules = MODULES[self.section]

local visible_count = math.max(
1,
math.floor(
(self.width * 0.72) /
(CARD_WIDTH * self.scale + CARD_GAP * self.scale)
)
)

self.scroll_index = math.min(
math.max(0, #modules - visible_count),
self.scroll_index + 1
)

build_garage(self)
end
end


function init(self)
self.nodes = {}
self.cards = {}
self.buttons = {}
self.section = "hulls"
self.scroll_index = 0
self.pressed = nil

load_selection(self)
build_garage(self)

msg.post(".", "acquire_input_focus")
print("[GARAGE] Initialized")
end


function final(self)
destroy_nodes(self)
end


function on_input(self, action_id, action)
if action_id ~= hash("touch") or not action then
return false
end

if action.pressed then
self.pressed = nil

for _, button in ipairs(self.buttons) do
if gui.pick_node(button.box, action.x, action.y) then
self.pressed = {
type = "button",
id = button.id,
}
return true
end
end

for _, card in ipairs(self.cards) do
if gui.pick_node(card.box, action.x, action.y) then
self.pressed = {
type = "card",
id = card.id,
}
return true
end
end

return false
end

if action.released and self.pressed then
local pressed = self.pressed
self.pressed = nil

if pressed.type == "button" then
for _, button in ipairs(self.buttons) do
if button.id == pressed.id
and gui.pick_node(button.box, action.x, action.y) then
activate_button(self, pressed.id)
return true
end
end

elseif pressed.type == "card" then
for _, card in ipairs(self.cards) do
if card.id == pressed.id
and gui.pick_node(card.box, action.x, action.y) then

if self.section == "hulls" then
self.hull_id = card.id
else
self.turret_id = card.id
end

save_selection(self)
build_garage(self)
return true
end
end
end
end

return false
end