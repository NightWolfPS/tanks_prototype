-- main_menu.gui_script
-- Main menu with a compact, manually selectable server dropdown.
-- Defold 1.13.1

local TEXT_SCALE = 36 / 72 -- Дополнительное уменьшение текста ещё на треть.
local COLORS = {
    background = vmath.vector4(0.055, 0.075, 0.085, 1.0),
    panel = vmath.vector4(0.10, 0.13, 0.14, 1.0),
    button = vmath.vector4(0.16, 0.22, 0.23, 1.0),
    accent = vmath.vector4(0.91, 0.63, 0.20, 1.0),
    text = vmath.vector4(0.93, 0.94, 0.90, 1.0),
    muted = vmath.vector4(0.58, 0.65, 0.64, 1.0)
}

local BUTTON_WIDTH = 300
local BUTTON_HEIGHT = 58
local BUTTON_GAP = 16
local SERVERS = {
    { id = "US1", url = "wss://tank-server-dfii.onrender.com" },
    { id = "US2", url = "wss://tank-server-3.onrender.com" },
    { id = "US3", url = "wss://tank-server.hostless.app" },
    { id = "EU1", url = "wss://tank-server-1.onrender.com" },
    { id = "EU2", url = "wss://tank-server.layero.app" },
    { id = "AS1", url = "wss://tank-server-2.onrender.com" }
}
local STATUS_POLL_INTERVAL = 5.0

local function log(message) print("[MAIN MENU] " .. tostring(message)) end

local function create_box(position, size, color)
    local node = gui.new_box_node(position, size)
    gui.set_color(node, color)
    return node
end

local function create_text(position, value, scale, color)
    local node = gui.new_text_node(position, value)
    gui.set_scale(node, vmath.vector3(scale * TEXT_SCALE, scale * TEXT_SCALE, 1))
    gui.set_color(node, color)
    return node
end

local function create_button(self, id, label, y)
    local center_x = self.width * 0.5
    local box = create_box(vmath.vector3(center_x, y, 0),
        vmath.vector3(self.button_width, self.button_height, 0), COLORS.button)
    local text = create_text(vmath.vector3(center_x, y, 0.1), label, self.scale, COLORS.text)
    table.insert(self.buttons, { id = id, box = box, label = text })
end

local function destroy_node(node)
    if node then gui.delete_node(node) end
end


local function hide_search_overlay(self)
    for _, node in ipairs(self.search_overlay_nodes or {}) do destroy_node(node) end
    self.search_overlay_nodes = {}
    self.search_overlay_open = false
end

local function show_search_overlay(self)
    hide_search_overlay(self)
    self.search_overlay_open = true
    self.search_elapsed = 0
    self.search_overlay_nodes = {}
    local function add_box(x, y, w, h, color, z)
        local n = create_box(vmath.vector3(x, y, z or 0.9), vmath.vector3(w, h, 0), color)
        self.search_overlay_nodes[#self.search_overlay_nodes + 1] = n
        return n
    end
    local function add_text(x, y, value, scale, color)
        local n = create_text(vmath.vector3(x, y, 1), value, scale, color)
        self.search_overlay_nodes[#self.search_overlay_nodes + 1] = n
        return n
    end
    local cx, cy = self.width * 0.5, self.height * 0.5
    add_box(cx, cy, self.width, self.height, vmath.vector4(0.005, 0.012, 0.015, 0.86), 0.85)
    add_text(cx, cy + 115 * self.scale, "ПОИСК БОЯ", 0.72 * self.scale, COLORS.accent)
    self.search_timer_node = add_text(cx, cy + 35 * self.scale, "00:00", 2.0 * self.scale, COLORS.text)
    add_text(cx - 70 * self.scale, cy - 50 * self.scale, "СЕРВЕР", 0.45 * self.scale, COLORS.muted)
    self.search_server_node = add_text(cx - 70 * self.scale, cy - 80 * self.scale,
        tostring(self.selected_server_id or "EU1"), 0.72 * self.scale, COLORS.text)
    add_text(cx + 100 * self.scale, cy - 50 * self.scale, "ИГРОКОВ В ОЧЕРЕДИ", 0.45 * self.scale, COLORS.muted)
    self.search_queue_node = add_text(cx + 100 * self.scale, cy - 80 * self.scale, "1", 0.72 * self.scale, COLORS.text)
    self.search_cancel_box = add_box(cx, cy - 155 * self.scale, 150 * self.scale, 38 * self.scale, COLORS.button, 0.95)
    add_text(cx, cy - 155 * self.scale, "ОТМЕНА", 0.52 * self.scale, COLORS.text)
end

local function destroy_menu(self)
    for _, key in ipairs({"background", "panel", "title", "subtitle", "footer", "server_button_box", "server_button_label", "server_status_label"}) do
        destroy_node(self[key]); self[key] = nil
    end
    if self.buttons then
        for _, button in ipairs(self.buttons) do destroy_node(button.label); destroy_node(button.box) end
        self.buttons = {}
    end
    if self.server_rows then
        for _, row in ipairs(self.server_rows) do destroy_node(row.label); destroy_node(row.box) end
        self.server_rows = {}
    end
    for _, button in ipairs(self.header_buttons or {}) do destroy_node(button.box); destroy_node(button.label) end
    self.header_buttons = {}
    destroy_node(self.header_background)
    destroy_node(self.header_brand)
    for _, node in ipairs(self.dashboard_nodes or {}) do destroy_node(node) end
    self.dashboard_nodes = {}
    hide_search_overlay(self)
end

local function build_menu(self)
    self.width = gui.get_width()
    self.height = gui.get_height()
    self.scale = math.min(1, self.width / 640, self.height / 480)
    self.button_width = BUTTON_WIDTH * self.scale
    self.button_height = BUTTON_HEIGHT * self.scale
    self.button_gap = BUTTON_GAP * self.scale

    -- self.background = create_box(vmath.vector3(self.width * 0.5, self.height * 0.5, -1),
        -- vmath.vector3(self.width, self.height, 0), COLORS.background)
    -- self.panel = create_box(vmath.vector3(self.width * 0.5, self.height * 0.5, -0.5),
        -- vmath.vector3(math.min(self.width * 0.82, 500 * self.scale), math.min(self.height * 0.88, 570 * self.scale), 0), COLORS.panel)
    local center_x = self.width * 0.5
    self.buttons = {}
    -- Постоянная верхняя навигация IRONGRID
    self.header_background = create_box(vmath.vector3(self.width * 0.5, self.height - 24 * self.scale, 0.8),
        vmath.vector3(self.width, 48 * self.scale, 0), vmath.vector4(0.025, 0.04, 0.045, 1))
    self.header_brand = create_text(vmath.vector3(76 * self.scale, self.height - 24 * self.scale, 1),
        "BATTLEFRONT", 0.9 * self.scale, vmath.vector4(0.20, 0.82, 0.88, 1))
    local nav_items = {
        {"ЗАДАЧИ", self.width * 0.23, "nav_tasks"},
        {"ДРУЗЬЯ", self.width * 0.33, "nav_friends"},
        {"В БОЙ", self.width * 0.43, "nav_battle"},
        {"ГАРАЖ", self.width * 0.53, "nav_garage"},
        {"МАГАЗИН", self.width * 0.63, "nav_shop"}
    }
    self.header_buttons = {}
    for _, item in ipairs(nav_items) do
        local box = create_box(vmath.vector3(item[2], self.height - 24 * self.scale, 0.9),
            vmath.vector3(92 * self.scale, 30 * self.scale, 0), item[3] == "nav_battle"
            and vmath.vector4(0.08, 0.27, 0.29, 1) or COLORS.button)
        local nav_label = create_text(vmath.vector3(item[2], self.height - 24 * self.scale, 1),
            item[1], 0.48 * self.scale, COLORS.text)
        self.header_buttons[#self.header_buttons + 1] = { id = item[3], box = box, label = nav_label }
    end
    local gear_box = create_box(vmath.vector3(self.width - 92 * self.scale, self.height - 24 * self.scale, 0.9),
        vmath.vector3(34 * self.scale, 30 * self.scale, 0), COLORS.button)
    local gear_label = create_text(vmath.vector3(self.width - 92 * self.scale, self.height - 24 * self.scale, 1),
        "S", 0.65 * self.scale, COLORS.text)
    self.header_buttons[#self.header_buttons + 1] = { id = "nav_settings", box = gear_box, label = gear_label }
    local logout_box = create_box(vmath.vector3(self.width - 48 * self.scale, self.height - 24 * self.scale, 0.9),
        vmath.vector3(34 * self.scale, 30 * self.scale, 0), COLORS.button)
    local logout_label = create_text(vmath.vector3(self.width - 48 * self.scale, self.height - 24 * self.scale, 1),
        "X", 0.65 * self.scale, COLORS.text)
    self.header_buttons[#self.header_buttons + 1] = { id = "nav_exit", box = logout_box, label = logout_label }
    -- Главная панель оператора и сводка сессии
    self.dashboard_nodes = {}
    local function dashboard_box(x, y, w, h, color)
        local n = create_box(vmath.vector3(x, y, 0.2), vmath.vector3(w, h, 0), color)
        self.dashboard_nodes[#self.dashboard_nodes + 1] = n
        return n
    end
    local function dashboard_text(x, y, value, scale, color)
        local n = create_text(vmath.vector3(x, y, 0.4), value, scale, color)
        self.dashboard_nodes[#self.dashboard_nodes + 1] = n
        return n
    end
    local left_x = self.width * 0.36
    local left_w = self.width * 0.56
    local right_x = self.width * 0.80
    local right_w = self.width * 0.18
    local top_y = self.height * 0.66
    local operator_box = dashboard_box(left_x, top_y, left_w, self.height * 0.34, COLORS.panel)
    table.remove(self.dashboard_nodes) -- ownership transferred to the clickable header-button list
    local profile_ok, profile_data = pcall(function() return sys.load("player.save") end)
    local nickname = profile_ok and type(profile_data) == "table" and profile_data.nickname or "ОПЕРАТОР"
    dashboard_text(left_x - left_w * 0.42, top_y + 28 * self.scale, "ОПЕРАТОР", 0.48 * self.scale, COLORS.muted)
    dashboard_text(left_x - left_w * 0.38, top_y - 5 * self.scale, tostring(nickname), 1.0 * self.scale, COLORS.text)
    dashboard_text(left_x - left_w * 0.42, top_y - 55 * self.scale, "УРОВЕНЬ  1", 0.5 * self.scale, COLORS.accent)
    dashboard_box(left_x, top_y - 82 * self.scale, left_w * 0.78, 5 * self.scale, COLORS.button)
    dashboard_box(left_x - left_w * 0.11, top_y - 82 * self.scale, left_w * 0.56, 4 * self.scale, COLORS.accent)
    self.header_buttons[#self.header_buttons + 1] = { id = "nav_profile", box = operator_box }

    dashboard_box(left_x, self.height * 0.29, left_w, self.height * 0.30, COLORS.panel)
    dashboard_text(left_x - left_w * 0, self.height * 0.41, "СРЕДНЯЯ СТАТИСТИКА ЗА СЕССИЮ", 0.45 * self.scale, COLORS.muted)
    local stats = {{"БОЁВ", "0"}, {"ПОБЕД", "—"}, {"У/С", "—"}, {"УРОН", "0"}}
    for i, stat in ipairs(stats) do
        local sx = left_x - left_w * 0.34 + (i - 1) * left_w * 0.22
        dashboard_box(sx, self.height * 0.28, left_w * 0.19, self.height * 0.12, COLORS.button)
        dashboard_text(sx, self.height * 0.30, stat[2], 0.8 * self.scale, COLORS.text)
        dashboard_text(sx, self.height * 0.25, stat[1], 0.38 * self.scale, COLORS.muted)
    end

    dashboard_box(right_x, self.height * 0.48, right_w, self.height * 0.70, COLORS.panel)
    dashboard_text(right_x, self.height * 0.79, "НОВОСТИ", 0.5 * self.scale, COLORS.accent)
    local news = {
        {"Сезон рейтинговых боёв", "Старт нового сезона. Награды для лучших операторов."},
        {"Технические работы", "Серверы могут быть временно недоступны."},
        {"Новая пушка: рельсотрон", "Высокий урон и долгая перезарядка."}
    }
    for i, item in ipairs(news) do
        local ny = self.height * 0.67 - (i - 1) * self.height * 0.18
        dashboard_box(right_x, ny, right_w * 0.88, self.height * 0.15, COLORS.button)
        dashboard_text(right_x - right_w * 0, ny + 18 * self.scale, item[1], 0.52 * self.scale, COLORS.text)
        dashboard_text(right_x - right_w * 0, ny - 12 * self.scale, item[2], 0.40 * self.scale, COLORS.muted)
    end

    -- Small selector in the upper-right corner; the rest of the menu layout is unchanged.
    local selector_w = 105 * self.scale
    local selector_h = 30 * self.scale
    local selector_x = self.width * 0.80
    local selector_y = self.height * 0.91
    self.server_button_box = create_box(vmath.vector3(selector_x, selector_y, 0.2), vmath.vector3(selector_w, selector_h, 0), COLORS.button)
    self.server_button_label = create_text(vmath.vector3(selector_x, selector_y, 0.3), "EU1  v", 0.55 * self.scale, COLORS.text)
    self.server_status_label = create_text(vmath.vector3(selector_x, selector_y - 20 * self.scale, 0.3), "Users online: ...", 0.42 * self.scale, COLORS.muted)
    self.server_selector = { x = selector_x, y = selector_y, w = selector_w, h = selector_h }
    self.server_rows = {}
    self.dropdown_open = false
    log("Menu created. GUI size: " .. tostring(self.width) .. "x" .. tostring(self.height))
end

local function set_battle_button_label(self, value)
    for _, button in ipairs(self.buttons or {}) do
        if button.id == "battle" and button.label then
            gui.set_text(button.label, value)
            break
        end
    end
end

local function set_status(self, message)
    if self.searching then return end
    local id = message.server_id or self.selected_server_id or "?"
    local users = tonumber(message.connected_users)
    self.selected_server_id = id
    if self.search_server_node then gui.set_text(self.search_server_node, tostring(id)) end
    if self.server_button_label then gui.set_text(self.server_button_label, id .. "  v") end
    if not message.connected then
        gui.set_text(self.server_status_label, "Users online: unavailable")
    elseif users and users >= 0 then
        gui.set_text(self.server_status_label, "Users online: " .. tostring(users))
    else
        gui.set_text(self.server_status_label, "Users online: ...")
    end
end

local function close_dropdown(self)
    for _, row in ipairs(self.server_rows or {}) do destroy_node(row.label); destroy_node(row.box) end
    self.server_rows = {}
    self.dropdown_open = false
end

local function open_dropdown(self)
    close_dropdown(self)
    self.dropdown_open = true
    local row_h = 27 * self.scale
    local top_y = self.server_selector.y - self.server_selector.h * 0.5 - row_h * 0.5
    for i, server in ipairs(SERVERS) do
        local y = top_y - (i - 1) * row_h
        local box = create_box(vmath.vector3(self.server_selector.x, y, 0.5), vmath.vector3(self.server_selector.w, row_h, 0), COLORS.button)
        local label = create_text(vmath.vector3(self.server_selector.x, y, 0.6), server.id .. "  -  " .. (server.id == self.selected_server_id and "SELECTED" or "Select server"), 0.42 * self.scale, server.id == self.selected_server_id and COLORS.accent or COLORS.text)
        table.insert(self.server_rows, { server_index = i, box = box, label = label })
    end
end

local function activate_button(self, id)
    if id == "nav_battle" then
        if self.searching then
            msg.post("bootstrap:/network_manager#network_manager", "network_cancel_match")
            self.searching = false
            hide_search_overlay(self)
            for _, b in ipairs(self.header_buttons or {}) do if b.id == "nav_battle" and b.label then gui.set_text(b.label, "В БОЙ") end end
            set_battle_button_label(self, "BATTLE")
        else
            self.searching = true
            show_search_overlay(self)
            for _, b in ipairs(self.header_buttons or {}) do if b.id == "nav_battle" and b.label then gui.set_text(b.label, "ОТМЕНА") end end
            msg.post("bootstrap:/network_manager#network_manager", "network_find_match")
        end
        return
    elseif id == "nav_garage" then
        msg.post("bootstrap:/scene_manager#scene_manager", "open_garage")
        return
    elseif id == "nav_settings" then
        msg.post("bootstrap:/scene_manager#scene_manager", "open_settings")
        return
    elseif id == "nav_profile" then
        msg.post("bootstrap:/scene_manager#scene_manager", "open_profile")
        return
    elseif id == "nav_exit" then
        sys.exit(0)
        return
    elseif id == "nav_tasks" or id == "nav_friends" or id == "nav_shop" then
        log("Navigation section is a visual placeholder: " .. id)
        return
    elseif id == "battle" then
        if self.searching then
            log("Cancelling matchmaking")
            msg.post("bootstrap:/network_manager#network_manager", "network_cancel_match")
            self.searching = false
            set_battle_button_label(self, "BATTLE")
            gui.set_text(self.server_status_label, "Search cancelled")
        else
            log("BATTLE selected; requesting matchmaking")
            self.searching = true
            set_battle_button_label(self, "CANCEL SEARCH")
            gui.set_text(self.server_status_label, "Searching for a match...")
            msg.post("bootstrap:/network_manager#network_manager", "network_find_match")
        end
    elseif id == "garage" then
        log("GARAGE selected")
        msg.post("bootstrap:/scene_manager#scene_manager", "open_garage")
    elseif id == "exit" then
        log("EXIT selected")
        sys.exit(0)
    end
end

function init(self)
    self.buttons = {}
    self.pressed_button = nil
    self.selected_server_id = "EU1"
    self.status_poll_timer = 0
    self.searching = false
    build_menu(self)
    msg.post(".", "acquire_input_focus")
    msg.post("bootstrap:/network_manager#network_manager", "network_get_server_status")
    log("Input focus requested")
end

function final(self) destroy_menu(self) end

function update(self, dt)
    if self.searching and self.search_overlay_open then
        self.search_elapsed = (self.search_elapsed or 0) + dt
        local seconds = math.floor(self.search_elapsed)
        if self.search_timer_node then
            gui.set_text(self.search_timer_node, string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60))
        end
    end
    self.status_poll_timer = self.status_poll_timer + dt
    if self.status_poll_timer >= STATUS_POLL_INTERVAL then
        self.status_poll_timer = 0
        msg.post("bootstrap:/network_manager#network_manager", "network_get_server_status")
    end
end

function on_message(self, message_id, message, sender)
    if message_id == hash("server_status_update") then
        set_status(self, message)
    elseif message_id == hash("matchmaking_waiting") then
        self.searching = true
        self.last_queue_count = tonumber(message.queue_count or message.players_count or self.last_queue_count) or 1
        if not self.search_overlay_open then show_search_overlay(self) end
        for _, b in ipairs(self.header_buttons or {}) do if b.id == "nav_battle" and b.label then gui.set_text(b.label, "ОТМЕНА") end end
        local queue_count = tonumber(message.queue_count or message.players_count or message.room_players_count)
        if queue_count then
            self.last_queue_count = math.max(0, queue_count)
            if self.search_queue_node then gui.set_text(self.search_queue_node, tostring(self.last_queue_count)) end
        elseif self.search_queue_node then
            gui.set_text(self.search_queue_node, tostring(self.last_queue_count or 1))
        end
        local max_players = tonumber(message.max_players) or 10
        set_battle_button_label(self, "CANCEL SEARCH")
        gui.set_text(self.server_status_label,
            "Waiting for players... " .. tostring(self.last_queue_count or 1)
            .. "/" .. tostring(max_players))
    elseif message_id == hash("matchmaking_failed") then
        self.searching = false
        hide_search_overlay(self)
        for _, b in ipairs(self.header_buttons or {}) do if b.id == "nav_battle" and b.label then gui.set_text(b.label, "В БОЙ") end end
        set_battle_button_label(self, "BATTLE")
        gui.set_text(self.server_status_label,
            "Matchmaking failed: " .. tostring(message.reason or "unknown"))
    end
end

function on_input(self, action_id, action)
    if action_id ~= hash("touch") or not action then return false end
    if action.pressed then
        self.pressed_button = nil
        if self.search_overlay_open and self.search_cancel_box and gui.pick_node(self.search_cancel_box, action.x, action.y) then
            self.pressed_button = "search_cancel"
            return true
        end
        if self.server_button_box and gui.pick_node(self.server_button_box, action.x, action.y) then
            self.pressed_button = "server_selector"
            return true
        end
        for _, row in ipairs(self.server_rows or {}) do
            if gui.pick_node(row.box, action.x, action.y) then
                self.pressed_button = "server:" .. tostring(row.server_index)
                return true
            end
        end
        for _, button in ipairs(self.header_buttons or {}) do
            if gui.pick_node(button.box, action.x, action.y) then
                self.pressed_button = button.id
                return true
            end
        end
        for _, button in ipairs(self.buttons or {}) do
            if gui.pick_node(button.box, action.x, action.y) then
                self.pressed_button = button.id
                return true
            end
        end
        if self.dropdown_open then close_dropdown(self) end
        return false
    elseif action.released then
        local pressed = self.pressed_button
        self.pressed_button = nil
        if not pressed then return false end
        if pressed == "search_cancel" and self.search_cancel_box and gui.pick_node(self.search_cancel_box, action.x, action.y) then
            msg.post("bootstrap:/network_manager#network_manager", "network_cancel_match")
            self.searching = false
            hide_search_overlay(self)
            for _, b in ipairs(self.header_buttons or {}) do if b.id == "nav_battle" and b.label then gui.set_text(b.label, "В БОЙ") end end
            return true
        end
        if pressed == "server_selector" and gui.pick_node(self.server_button_box, action.x, action.y) then
            if self.dropdown_open then close_dropdown(self) else open_dropdown(self) end
            return true
        end
        local index = tonumber(string.match(pressed, "^server:(%d+)$"))
        if index then
            for _, row in ipairs(self.server_rows or {}) do
                if row.server_index == index and gui.pick_node(row.box, action.x, action.y) then
                    self.selected_server_id = SERVERS[index].id
                    close_dropdown(self)
                    set_status(self, { server_id = self.selected_server_id, connected = false })
                    msg.post("bootstrap:/network_manager#network_manager", "network_select_server", { server_index = index })
                    return true
                end
            end
        end
        for _, button in ipairs(self.header_buttons or {}) do
            if button.id == pressed and gui.pick_node(button.box, action.x, action.y) then
                activate_button(self, pressed)
                return true
            end
        end
        for _, button in ipairs(self.buttons or {}) do
            if button.id == pressed and gui.pick_node(button.box, action.x, action.y) then
                activate_button(self, pressed)
                return true
            end
        end
        return false
    end
    return false
end
